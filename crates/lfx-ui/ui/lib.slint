// Einstieg der LENZFLIX-Oberfläche: Design-Wahl (Theme), Datentypen, Galerie und Probe-Fenster.
// Die Komponenten selbst (LfxButton, LfxCard, LfxRow, …) liegen in components/index.slint; Seiten anderer Crates
// importieren sie von dort (Include-Pfad `lfx_ui::UI_DIR`). Hier wird bewusst nur exportiert, was Rust braucht,
// weil Slint für exportierte Nicht-Window-Komponenten Warnungen ausgibt.
import {
    Shadow, DesignTokens, TokensFlix, TokensPlus, TokensPrime, TokensRetro
} from "theme/tokens.slint";
import { Design, Theme } from "theme/theme.slint";
import { CardAspect, CardData, ButtonKind, ToastKind, HitRect, TitleBarHit, AvatarData } from "components/types.slint";
import { Gallery } from "gallery.slint";
import { MainWindow } from "pages/main.slint";
import { TvState, TvChanRow, TvCellData, TvEpgRowData, TvMark } from "pages/tvui-types.slint";  // W2-tvui
import { Page, RowData, HeroData, HomeGeometry } from "pages/types.slint";
import { LibraryState, LibTool, NpEntry, LibChip, LibGeometry } from "pages/library.slint"; // W2-library
import { PlayerView, MenuRow } from "pages/player-types.slint"; // W2-player
import { DetailState, DetailData, EpisodeData, SimilarCard, PersonChip, MenuEntry, HoverData } from "pages/detail-state.slint"; // W2-detail
import { HCard, HRow, HomeLayout, HomeUi } from "pages/home-types.slint"; // W2-home
import { PlusBrand } from "components/plus-parts.slint"; // W3-plus

export {
    Shadow, DesignTokens, TokensFlix, TokensPlus, TokensPrime, TokensRetro, Design, Theme,
    CardAspect, CardData, ButtonKind, ToastKind, HitRect, TitleBarHit, AvatarData, Gallery,
    TvState, TvChanRow, TvCellData, TvEpgRowData, TvMark,  // W2-tvui
    LibraryState, LibTool, NpEntry, LibChip, LibGeometry, // W2-library
    MainWindow, Page, RowData, HeroData, HomeGeometry, PlayerView, MenuRow, // W2-player
    DetailState, DetailData, EpisodeData, SimilarCard, PersonChip, MenuEntry, HoverData, // W2-detail
    HCard, HRow, HomeLayout, HomeUi, // W2-home
    PlusBrand // W3-plus
}

// Minimales Fenster, das Theme-Werte sichtbar macht (Tests).
export component ThemeProbe inherits Window {
    background: Theme.t.bg;
    in-out property <string> font-name: Theme.t.font-family;
    Rectangle {
        background: Theme.t.red;
    }
}
