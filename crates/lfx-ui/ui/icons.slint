    out property <image> chevron-right: @image-url("../../../assets/icons/chevron-right.svg");
    out property <image> chevron-up: @image-url("../../../assets/icons/chevron-up.svg");
    out property <image> close: @image-url("../../../assets/icons/close.svg");
    out property <image> datasaver: @image-url("../../../assets/icons/datasaver.svg");
    out property <image> dislike: @image-url("../../../assets/icons/dislike.svg");
    out property <image> download: @image-url("../../../assets/icons/download.svg");
    out property <image> eye-check: @image-url("../../../assets/icons/eye-check.svg");
    out property <image> eye: @image-url("../../../assets/icons/eye.svg");
    out property <image> fullscreen: @image-url("../../../assets/icons/fullscreen.svg");
    out property <image> home: @image-url("../../../assets/icons/home.svg");
    out property <image> info: @image-url("../../../assets/icons/info.svg");
    out property <image> like-outline: @image-url("../../../assets/icons/like-outline.svg");
    out property <image> like: @image-url("../../../assets/icons/like.svg");
    out property <image> more: @image-url("../../../assets/icons/more.svg");
    out property <image> mute: @image-url("../../../assets/icons/mute.svg");
    out property <image> pause: @image-url("../../../assets/icons/pause.svg");
    out property <image> play: @image-url("../../../assets/icons/play.svg");
    out property <image> plus: @image-url("../../../assets/icons/plus.svg");
    out property <image> search: @image-url("../../../assets/icons/search.svg");
    out property <image> settings: @image-url("../../../assets/icons/settings.svg");
    out property <image> subtitles: @image-url("../../../assets/icons/subtitles.svg");
