// Icon-Verzeichnis: SVGs aus assets/icons (weiß, per `colorize` einfärben).
// Web-Icons stammen aus tools/icons/extract.mjs, der Rest ist handgezeichnet.
export global Icons {
    out property <image> back: @image-url("../../../assets/icons/back.svg");
    out property <image> bell: @image-url("../../../assets/icons/bell.svg");
    out property <image> check: @image-url("../../../assets/icons/check.svg");
    out property <image> chevron-down: @image-url("../../../assets/icons/chevron-down.svg");
