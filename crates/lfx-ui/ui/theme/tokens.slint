// ---- LENZ//84 (retro) ----
export global TokensRetro {
    out property <DesignTokens> v: {
        // Jellyfin-Palette (MUI)
        jf-primary-main: #ffb000,
        jf-primary-light: #ffe2a8,
        jf-primary-dark: #a86a00,
        jf-primary-contrast: #0a0603,
        jf-secondary-main: #ff5a1f,
        jf-bg-default: #0a0603,
        jf-bg-paper: #140c05,
        jf-appbar-bg: #0a0603,
        jf-text-primary: #ffb000,
        jf-text-secondary: #c98a12,
        jf-divider: rgba(255, 255, 255, 0.12),
        jf-snackbar-bg: #2f2f2f,
        jf-filled-input-bg: rgba(22, 22, 22, 0.7),
        jf-button-bg: rgba(109, 109, 110, 0.7),
        jf-button-hover-bg: rgba(109, 109, 110, 0.4),
        jf-card-radius: 8px,
        jf-shape-radius: 4px,
        // Farben (--lfx-*)
        red: #ffb000,
        red-hover: #ffe2a8,
        red-active: #a86a00,
        accent: #ffb000,
        link: #ffe2a8,
        progress: #ffb000, // Rückfall auf --lfx-accent
        bg: #0a0603,
        bg-deep: #050301,
        surface: #140c05,
        surface-2: #1d1208,
        surface-3: #2a1a0a,
        border: #5a3b08,
        text: #ffe2a8,
        text-body: #ffb000,
        text-muted: #c98a12,
        text-soft: #8a5d10,
        gold: #ffe2a8,
        gold-hover: #fff1d2,
        green: #ffb000,
        green-soft: rgba(255, 176, 0, 0.12),
        glass: rgba(20, 12, 5, 0.86),
        glass-hover: rgba(255, 176, 0, 0.18),
        pill-active: rgba(255, 176, 0, 0.18),
        pill-soft: rgba(255, 255, 255, 0.12),
        icon-circle: rgba(10, 6, 3, 0.7),
        icon-circle-border: rgba(255, 176, 0, 0.55),
        progress-rail: rgba(255, 176, 0, 0.85),
        ambient: rgb(40, 22, 4),
        // Typografie
        font-family: "Space Mono", // CSS: "LenzRetro Mono", ui-monospace, "Cascadia Mono", Consolas, monospace
        fs-nav: 18px,
        fs-row-title: 18px,
        fs-meta: 15px,
        fs-button: 20px,
        fs-badge: 12px,
        fs-body: 16px,
        fw-nav: 400,
        fw-row-title: 400,
        fw-button: 400,
        // Maße
        gutter: 36px,
        header-h: 64px,
        nav-pill-h: 36px,
        card-gap: 7.5px,
        cards-visible: 4,
        card-peek: 13px,
        card-radius: 2px,
        row-title-gap: 14px,
        row-gap: 40px,
        billboard-radius: 0px,
        billboard-ratio: 2.184411,
        btn-h: 48px,
        btn-radius: 2px,
        btn-gap: 12px,
        badge-h: 18px,
        popup-radius: 2px,
        modal-radius: 2px,
        // Bewegung
        ease: cubic-bezier(0.4, 0, 0.2, 1),
        ease-out: cubic-bezier(0, 0, 0.2, 1),
        dur-fast: 150ms,
        dur: 250ms,
        hover-delay: 500ms,
        // Schatten (jeweils die erste Schicht mit Unschärfe; Rest siehe Kommentar je Design)
        shadow-card: { x: 0px, y: 0px, blur: 22px, spread: 0px, color: rgba(255, 176, 0, 0.18) }, // 2 Schichten, übernommen wird die 2.; Original: 0 0 0 1px rgba(255, 176, 0, 0.35), 0 0 22px rgba(255, 176, 0, 0.18)
        shadow-modal: { x: 0px, y: 0px, blur: 48px, spread: 0px, color: rgba(255, 176, 0, 0.16) }, // 3 Schichten, übernommen wird die 2.; Original: 0 0 0 1px rgba(255, 176, 0, 0.45), 0 0 48px rgba(255, 176, 0, 0.16), 0 24px 64px rgba(0, 0, 0, 0.9)
        // LENZ+ (plus-*, in anderen Designs Nullwerte)
        plus-nav-idle: transparent,
        plus-circle: transparent,
        plus-menu-bg: transparent,
        plus-menu-border: transparent,
        plus-letter-spacing: 0px,
        plus-letter-spacing-bold: 0px,
        // LENZPRIME (prime-*, in anderen Designs Nullwerte)
        prime-glass: transparent,
        prime-chip: transparent,
        prime-hover-bg: transparent,
        prime-ink: transparent,
        prime-gutter: 0px,
        prime-header-h: 0px,
        prime-shadow: { x: 0px, y: 0px, blur: 0px, spread: 0px, color: transparent },
        // LENZ//84 (retro-*, in anderen Designs Nullwerte)
        retro-amber: #ffb000,
        retro-amber-hi: #ffe2a8,
        retro-amber-lo: #a86a00,
        retro-amber-dim: rgba(255, 176, 0, 0.14),
        retro-hot: #ff5a1f,
        retro-glitch-a: #ff2b6d,
        retro-glitch-b: #22e4ff,
        retro-bg: #0a0603,
        retro-bg-2: #120a04,
        retro-panel: rgba(20, 12, 5, 0.88),
        retro-line: rgba(255, 176, 0, 0.45),
        retro-ink: #0a0603,
        retro-glow: { x: 0px, y: 0px, blur: 6px, spread: 0px, color: rgba(255, 176, 0, 0.55) }, // 2 Schichten, übernommen wird die 1.; Original: 0 0 6px rgba(255, 176, 0, 0.55), 0 0 18px rgba(255, 120, 0, 0.28)
        retro-glow-strong: { x: 0px, y: 0px, blur: 4px, spread: 0px, color: rgba(255, 226, 168, 0.9) }, // 3 Schichten, übernommen wird die 1.; Original: 0 0 4px rgba(255, 226, 168, 0.9), 0 0 14px rgba(255, 176, 0, 0.75), 0 0 32px rgba(255, 90, 31, 0.45)
        retro-box-glow: { x: 0px, y: 0px, blur: 14px, spread: 0px, color: rgba(255, 176, 0, 0.28) }, // 3 Schichten, übernommen wird die 2.; Original: 0 0 0 1px rgba(255, 176, 0, 0.5), 0 0 14px rgba(255, 176, 0, 0.28), inset 0 0 14px rgba(255, 176, 0, 0.1)
        retro-font-pixel: "VT323", // CSS: "LenzRetro Pixel", "VT323", ui-monospace, monospace
        retro-font-mono: "Space Mono", // CSS: "LenzRetro Mono", ui-monospace, "Cascadia Mono", Consolas, monospace
        retro-ease-crt: cubic-bezier(0.2, 0.9, 0.25, 1),
        retro-dur-glitch: 280ms,
        retro-gutter: 64px,
    };
    // cards-visible: Breakpoints aus den Media-Queries (CSS-px)
    pure public function cards-visible-at(w: length) -> int {
        if (w < 800px) { return 2; }
        if (w < 1100px) { return 3; }
        if (w < 1400px) { return 4; }
        if (w < 1800px) { return 5; }
        return 6;
    }
    // gutter: Breakpoints aus den Media-Queries (CSS-px)
    pure public function gutter-at(w: length) -> length {
        if (w < 800px) { return w * 0.04; }
        if (w < 1400px) { return 36px; }
        if (w < 1800px) { return w * 0.03; }
        return 60px;
    }
}

// ---- Hinweise zur Übersetzung (nicht oder nur genähert übersetzbar) ----
// - LENZ//84: Verlauf --lfx-retro-scan (Scanlines) hat kein Slint-Gegenstück als Token; Umsetzung später als Bild/Shader
// - LENZ+: --lfx-gutter (gutter) = "3.7vw" bei Referenzbreite 1920 px aufgelöst: 71.04px
// - LENZPRIME: --lfx-shadow-card (shadow-card) hat 2 Schatten-Schichten; Slint kennt nur eine (Schicht 1 übernommen), Spread wird von Slint ignoriert
// - LENZPRIME: --lfx-prime-gutter (prime-gutter) = "clamp(20px, 3.75vw, 72px)" bei Referenzbreite 1920 px aufgelöst: 72px
// - LENZPRIME: --lfx-prime-shadow (prime-shadow) hat 2 Schatten-Schichten; Slint kennt nur eine (Schicht 1 übernommen), Spread wird von Slint ignoriert
// - LENZ//84: --lfx-shadow-card (shadow-card) hat 2 Schatten-Schichten; Slint kennt nur eine (Schicht 2 übernommen), Spread wird von Slint ignoriert
// - LENZ//84: --lfx-shadow-modal (shadow-modal) hat 3 Schatten-Schichten; Slint kennt nur eine (Schicht 2 übernommen), Spread wird von Slint ignoriert
// - LENZ//84: --lfx-retro-glow (retro-glow) hat 2 Schatten-Schichten; Slint kennt nur eine (Schicht 1 übernommen), Spread wird von Slint ignoriert
// - LENZ//84: --lfx-retro-glow-strong (retro-glow-strong) hat 3 Schatten-Schichten; Slint kennt nur eine (Schicht 1 übernommen), Spread wird von Slint ignoriert
// - LENZ//84: --lfx-retro-box-glow (retro-box-glow) hat 3 Schatten-Schichten; Slint kennt nur eine (Schicht 2 übernommen), Spread wird von Slint ignoriert
// - LENZ//84: --lfx-retro-gutter (retro-gutter) = "clamp(16px, 3.4vw, 64px)" bei Referenzbreite 1920 px aufgelöst: 64px
