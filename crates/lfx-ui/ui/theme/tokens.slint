        jf-text-primary: #ffffff,
        jf-text-secondary: #b3b3b3,
        jf-divider: rgba(255, 255, 255, 0.12),
        jf-snackbar-bg: #2f2f2f,
        jf-filled-input-bg: rgba(22, 22, 22, 0.7),
        jf-button-bg: rgba(109, 109, 110, 0.7),
        jf-button-hover-bg: rgba(109, 109, 110, 0.4),
        jf-card-radius: 8px,
        jf-shape-radius: 4px,
        // Farben (--lfx-*)
        red: #e50914,
        red-hover: #f40612,
        red-active: #b81d24,
        accent: #e50914, // Rückfall auf --lfx-red
        link: #f40612, // Rückfall auf --lfx-red-hover
        progress: #e50914, // Rückfall auf --lfx-red
        bg: #141414,
        bg-deep: #0c0c0c,
        surface: #181818,
        surface-2: #232323,
        surface-3: #2f2f2f,
        border: #404040,
        text: #ffffff,
        text-body: #e5e5e5,
        text-muted: #b3b3b3,
        text-soft: #808080,
        gold: #e3c36a,
        gold-hover: #f1d98f,
        green: #46d369,
        green-soft: rgba(70, 211, 105, 0.12),
        glass: rgba(109, 109, 110, 0.7),
        glass-hover: rgba(109, 109, 110, 0.4),
        pill-active: rgba(255, 255, 255, 0.2),
        pill-soft: rgba(255, 255, 255, 0.12),
        icon-circle: rgba(42, 42, 42, 0.6),
        icon-circle-border: rgba(255, 255, 255, 0.5),
        progress-rail: rgba(255, 255, 255, 0.85),
        ambient: rgb(27, 40, 41),
        // Typografie
        font-family: "Inter", // CSS: "LenzFlix Sans", "Helvetica Neue", Helvetica, Arial, sans-serif
        fs-nav: 16px,
        fs-row-title: 18px,
        fs-meta: 15px,
        fs-button: 20px,
        fs-badge: 12px,
        fs-body: 16px,
        fw-nav: 500,
        fw-row-title: 600,
        fw-button: 600,
        // Maße
        gutter: 36px,
        header-h: 80px,
        nav-pill-h: 40px,
        card-gap: 7.5px,
        cards-visible: 4,
        card-peek: 13px,
        card-radius: 8px,
        row-title-gap: 14px,
        row-gap: 40px,
        billboard-radius: 18px,
        billboard-ratio: 2.184411,
        btn-h: 48px,
        btn-radius: 24px,
        btn-gap: 12px,
        badge-h: 18px,
        popup-radius: 8px,
        modal-radius: 8px,
        // Bewegung
        ease: cubic-bezier(0.4, 0, 0.2, 1),
        ease-out: cubic-bezier(0, 0, 0.2, 1),
        dur-fast: 150ms,
        dur: 250ms,
        hover-delay: 500ms,
        // Schatten (jeweils die erste Schicht mit Unschärfe; Rest siehe Kommentar je Design)
        shadow-card: { x: 0px, y: 16px, blur: 32px, spread: 0px, color: rgba(0, 0, 0, 0.75) },
        shadow-modal: { x: 0px, y: 32px, blur: 64px, spread: 0px, color: rgba(0, 0, 0, 0.85) },
        // LENZ+ (plus-*, in anderen Designs Nullwerte)
        plus-nav-idle: transparent,
        plus-circle: transparent,
        plus-menu-bg: transparent,
        plus-menu-border: transparent,
        plus-letter-spacing: 0px,
        plus-letter-spacing-bold: 0px,
        // LENZPRIME (prime-*, in anderen Designs Nullwerte)
        prime-glass: transparent,
        prime-chip: transparent,
        prime-hover-bg: transparent,
        prime-ink: transparent,
        prime-gutter: 0px,
        prime-header-h: 0px,
        prime-shadow: { x: 0px, y: 0px, blur: 0px, spread: 0px, color: transparent },
        // LENZ//84 (retro-*, in anderen Designs Nullwerte)
        retro-amber: transparent,
        retro-amber-hi: transparent,
        retro-amber-lo: transparent,
        retro-amber-dim: transparent,
        retro-hot: transparent,
        retro-glitch-a: transparent,
        retro-glitch-b: transparent,
        retro-bg: transparent,
        retro-bg-2: transparent,
        retro-panel: transparent,
        retro-line: transparent,
        retro-ink: transparent,
        retro-glow: { x: 0px, y: 0px, blur: 0px, spread: 0px, color: transparent },
        retro-glow-strong: { x: 0px, y: 0px, blur: 0px, spread: 0px, color: transparent },
        retro-box-glow: { x: 0px, y: 0px, blur: 0px, spread: 0px, color: transparent },
        retro-font-pixel: "",
        retro-font-mono: "",
        retro-ease-crt: linear,
        retro-dur-glitch: 0ms,
        retro-gutter: 0px,
    };
    // cards-visible: Breakpoints aus den Media-Queries (CSS-px)
    pure public function cards-visible-at(w: length) -> int {
        if (w < 800px) { return 2; }
        if (w < 1100px) { return 3; }
        if (w < 1400px) { return 4; }
        if (w < 1800px) { return 5; }
        return 6;
    }
    // gutter: Breakpoints aus den Media-Queries (CSS-px)
    pure public function gutter-at(w: length) -> length {
        if (w < 800px) { return w * 0.04; }
        if (w < 1400px) { return 36px; }
        if (w < 1800px) { return w * 0.03; }
        return 60px;
    }
}

