// Generiert von tools/tokens/extract.mjs – nicht von Hand ändern.
// Quelle: src/css/tokens.css und src/css/themes/{plus,prime,retro}/tokens.css der Web-Vorlage (store bewusst ausgelassen).
//
// Aufbau: ein `DesignTokens`-Struct (alle Felder für alle Designs) und je Design ein Global
// (TokensFlix, TokensPlus, TokensPrime, TokensRetro) mit `out property <DesignTokens> v`.
// Ein späteres Theme-Global wählt per Design-Enum (flix, plus, prime, retro) das passende Global.
// Designs erben wie in der Web-Kaskade die Kern-Tokens (LENZFLIX); Felder, die ein Design nicht
// kennt (z. B. retro-* in LENZ+), tragen Nullwerte (transparent / 0px / "").
// Zusätzlich je Global: `cards-visible-at(width)` und `gutter-at(width)` (Breakpoints der Media-Queries).
//
// Konventionen: rem = 16px; vw und clamp() werden bei 1920 px Referenzbreite zu festen Längen aufgelöst
// (die Breitenabhängigkeit liefert gutter-at()). Schriftfamilien sind die echten Familiennamen der
// eingebetteten Schriften (z. B. "Inter" statt CSS-Name "LenzFlix Sans"). Schatten: Slint kennt nur eine
// Schicht ohne Spread, übernommen wird die erste Schicht mit Unschärfe.
// Nicht übernommen: --*Channel-Tokens (Redundanz), --lfx-css (Web-Marker), --lfx-retro-scan (Verlauf).

export struct Shadow {
    x: length,
    y: length,
    blur: length,
    spread: length,
    color: color,
}

export struct DesignTokens {
    // Jellyfin-Palette (MUI)
    jf-primary-main: color,
    jf-primary-light: color,
    jf-primary-dark: color,
    jf-primary-contrast: color,
    jf-secondary-main: color,
    jf-bg-default: color,
    jf-bg-paper: color,
    jf-appbar-bg: color,
    jf-text-primary: color,
    jf-text-secondary: color,
    jf-divider: color,
    jf-snackbar-bg: color,
    jf-filled-input-bg: color,
    jf-button-bg: color,
    jf-button-hover-bg: color,
    jf-card-radius: length,
    jf-shape-radius: length,
    // Farben (--lfx-*)
    red: color,
    red-hover: color,
    red-active: color,
    accent: color,
    link: color,
    progress: color,
    bg: color,
    bg-deep: color,
    surface: color,
    surface-2: color,
    surface-3: color,
    border: color,
    text: color,
    text-body: color,
    text-muted: color,
    text-soft: color,
    gold: color,
    gold-hover: color,
    green: color,
    green-soft: color,
    glass: color,
    glass-hover: color,
    pill-active: color,
    pill-soft: color,
    icon-circle: color,
    icon-circle-border: color,
    progress-rail: color,
    ambient: color,
    // Typografie
    font-family: string,
    fs-nav: length,
    fs-row-title: length,
    fs-meta: length,
    fs-button: length,
    fs-badge: length,
    fs-body: length,
    fw-nav: int,
    fw-row-title: int,
    fw-button: int,
    // Maße
    gutter: length,
    header-h: length,
    nav-pill-h: length,
    card-gap: length,
    cards-visible: int,
    card-peek: length,
    card-radius: length,
    row-title-gap: length,
    row-gap: length,
    billboard-radius: length,
    billboard-ratio: float,
    btn-h: length,
    btn-radius: length,
    btn-gap: length,
    badge-h: length,
    popup-radius: length,
    modal-radius: length,
    // Bewegung
    ease: easing,
    ease-out: easing,
    dur-fast: duration,
    dur: duration,
    hover-delay: duration,
    // Schatten (jeweils die erste Schicht mit Unschärfe; Rest siehe Kommentar je Design)
    shadow-card: Shadow,
    shadow-modal: Shadow,
    // LENZ+ (plus-*, in anderen Designs Nullwerte)
    plus-nav-idle: color,
    plus-circle: color,
    plus-menu-bg: color,
    plus-menu-border: color,
    plus-letter-spacing: length,
    plus-letter-spacing-bold: length,
    // LENZPRIME (prime-*, in anderen Designs Nullwerte)
    prime-glass: color,
    prime-chip: color,
    prime-hover-bg: color,
    prime-ink: color,
    prime-gutter: length,
    prime-header-h: length,
    prime-shadow: Shadow,
    // LENZ//84 (retro-*, in anderen Designs Nullwerte)
    retro-amber: color,
    retro-amber-hi: color,
    retro-amber-lo: color,
    retro-amber-dim: color,
    retro-hot: color,
    retro-glitch-a: color,
    retro-glitch-b: color,
    retro-bg: color,
    retro-bg-2: color,
    retro-panel: color,
    retro-line: color,
    retro-ink: color,
    retro-glow: Shadow,
    retro-glow-strong: Shadow,
    retro-box-glow: Shadow,
    retro-font-pixel: string,
    retro-font-mono: string,
    retro-ease-crt: easing,
    retro-dur-glitch: duration,
    retro-gutter: length,
}

