import { Theme, Design } from "../theme/theme.slint";
import { AvatarData, ToastKind, TitleBarHit } from "../components/types.slint";
import { LfxTitleBar } from "../components/titlebar.slint";
import { LfxToast } from "../components/feedback.slint";
import { Page, RowData, HeroData, HomeGeometry } from "types.slint";
import { AddServerPage, ProfilesPage, LoginPage } from "auth.slint";
import { HomePage } from "home.slint";
import { PrimeHomePage } from "prime-home.slint"; // W3-prime
import { HRow, HomeLayout, HomeUi } from "home-types.slint"; // W2-home
import { PlayerPage } from "player.slint";
import { TvPage } from "tvui.slint";  // W2-tvui
import { LibraryPage } from "library.slint"; // W2-library
import { PlayerView } from "player-types.slint"; // W2-player
import { SoonPage, SettingsPage, AboutPage } from "misc.slint";
import { RetroFxLayer } from "../components/retro-fx.slint"; // W3-retro
import { AccountPage } from "account.slint"; // W4-account
import { DetailPage, DetailOverlays } from "detail-layer.slint"; // W2-detail
import { PlusHomePage } from "plus-home.slint"; // W3-plus
import { PlusTitlePage } from "plus-title.slint"; // W3-plus
import { PlusBrand } from "../components/plus-parts.slint"; // W3-plus
import { PickerOverlay } from "picker.slint"; // W3-picker
import { PickerState } from "picker-state.slint"; // W3-picker
import { HomeChrome } from "../components/home-chrome.slint"; // W3-picker: Kopfleiste auch auf der Detailseite
import { MediaPage, MediaBar, MediaOverlays, MediaUi } from "media.slint"; // W4-media
import { DownloadsPage } from "downloads.slint"; // W5-downloads
import { DlState } from "downloads-state.slint"; // W5-downloads
import { DlDialog, DlBanner } from "../components/downloads-dialog.slint"; // W5-downloads

// Hauptfenster von LENZFLIX Desktop. Rust (lfx-app) hält Router, Zustand und Fokus und setzt die Properties;
// die Oberfläche meldet nur Ereignisse. Durchsichtiger Fensterhintergrund: das Video liegt in einer Ebene darunter.
export component MainWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "LENZFLIX";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 640px;
    min-height: 420px;

    in property <Page> page: Page.add-server;
    in property <bool> mac: false;
    in property <bool> is-maximized: false;
    in property <string> toast;
    in property <ToastKind> toast-kind: ToastKind.info;

    // Titelleiste
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback drag-started();
    callback titlebar-hit(TitleBarHit);
    // Tastatur (Text der Taste, Strg, Umschalt, Alt)
    callback key(string, bool, bool, bool);

    // Server hinzufügen
    in-out property <string> server-url;
    in property <int> add-slot;
    in property <bool> add-busy;
    in property <string> add-error;
    callback add-submit(string);
    // Profile
    in property <[AvatarData]> avatars;
    in property <string> server-name;
    in property <int> profile-slot;
    in property <bool> profile-busy;
    in property <string> profile-error;
    callback profile-clicked(int);
    callback other-user();
    callback change-server();
    // Anmeldung
    in-out property <string> login-user;
    in-out property <string> login-password;
    in property <int> login-slot;
    in property <bool> login-busy;
    in property <string> login-error;
    in property <string> qc-code;
    in property <string> qc-hint;
    callback login-submit(string, string);
    callback login-quick-connect();
    callback login-back();
    callback login-field-accepted(int);
    // Startseite
    in property <HeroData> hero;
    in property <[RowData]> rows;
    in property <bool> home-loading;
    in property <string> home-error;
    in property <int> focus-row: -1;
    in property <int> focus-index: 0;
    in property <[string]> nav-labels;
    in property <int> nav-current;
    callback nav-selected(int);
    callback hero-play();
    callback hero-info();
    callback card-clicked(int, int);
    callback home-geometry(HomeGeometry);
    // Player (W2-player)
    in property <PlayerView> pv;
    callback player-cmd(string, float);
    // W2-home: neue Startseite (Kopfleiste, Billboard, Zeilen, Menüs, Trailer)
    in property <[HRow]> home-rows;
    in property <HomeUi> home-ui;
    in property <[PlusBrand]> plus-brands; // W3-plus
    callback home-event(string, int);
    callback home-event-f(string, float);
    callback home-layout(HomeLayout);
    callback home-trailer-rect(length, length, length, length);
    // Folgt-Seite, Einstellungen, Über
    in property <string> soon-title;
    in property <int> simple-slot;
    in property <int> design: 0;
    in property <string> user-name;
    in property <string> version;
    in property <string> notices;
    callback simple-back();
    callback design-chosen(int);
    callback about();
    callback sign-out();

    // W3-picker: Couch-Zoom (TV-Stil, 125 %), nicht im Player und im TV-Modus (eigene große Oberfläche)
    property <float> zf: (Theme.couch && root.page != Page.player && root.page != Page.tvmode) ? 1.25 : 1.0;

    public function focus-root() { fs.focus(); }
    // Zähler, den Rust erhöht, um den Textcursor in das Feld des aktuellen Slots zu setzen.
    in property <int> field-focus-tick;

    fs := FocusScope {
        key-pressed(e) => {
            root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
            accept
        }

        // W3-picker: Mausbewegung auf freien Flächen (Couch-Modus kehrt zur Maus zurück)
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.move) { PickerState.pointer-moved(self.mouse-x, self.mouse-y); }
            }
        }

        zoomwrap := Rectangle { // W3-picker
        width: parent.width / root.zf;
        height: parent.height / root.zf;
        x: (parent.width - self.width) / 2; // Skalierung um die Mitte, daher so versetzen, dass das Fenster gefüllt bleibt
        y: (parent.height - self.height) / 2;
        transform-scale: root.zf;

        // Seitenhintergrund (im Player durchsichtig)
        Rectangle {
            y: bar.height / root.zf;
            height: parent.height - bar.height / root.zf;
            background: (root.page == Page.player || root.page == Page.tvmode || root.page == Page.home) ? transparent : Theme.t.bg;  // W2-tvui, W2-home: Startseite malt den Hintergrund selbst (Trailer-Loch)

            if root.page == Page.add-server: AddServerPage {
                field-focus-tick: root.field-focus-tick;
                url <=> root.server-url;
                focus-slot: root.add-slot;
                busy: root.add-busy;
                error: root.add-error;
                submit(u) => { root.add-submit(u); }
            }
            if root.page == Page.profiles: ProfilesPage {
                avatars: root.avatars;
                server-name: root.server-name;
                focus-slot: root.profile-slot;
                busy: root.profile-busy;
                error: root.profile-error;
                profile-clicked(i) => { root.profile-clicked(i); }
                other-user => { root.other-user(); }
                change-server => { root.change-server(); }
            }
            if root.page == Page.login: LoginPage {
                field-focus-tick: root.field-focus-tick;
                user-name <=> root.login-user;
                password <=> root.login-password;
                server-name: root.server-name;
                focus-slot: root.login-slot;
                busy: root.login-busy;
                error: root.login-error;
                qc-code: root.qc-code;
                qc-hint: root.qc-hint;
                submit(u, p) => { root.login-submit(u, p); }
                quick-connect => { root.login-quick-connect(); }
                back => { root.login-back(); }
                field-accepted(s) => { root.login-field-accepted(s); }
            }
            if root.page == Page.home && Theme.design != Design.plus && Theme.design != Design.prime: HomePage { // W2-home W3-plus W3-prime
                hero: root.hero;
                rows: root.home-rows;
                loading: root.home-loading;
                error: root.home-error;
                focus-row: root.focus-row;
                focus-index: root.focus-index;
                ui: root.home-ui;
                version: root.version;
                event(k, v) => { root.home-event(k, v); }
                event-f(k, v) => { root.home-event-f(k, v); }
                card-clicked(r, i) => { root.card-clicked(r, i); }
                layout-changed(l) => { root.home-layout(l); }
                trailer-rect(x, y, w, h) => { root.home-trailer-rect(x, y, w, h); }
            }
            if root.page == Page.home && Theme.design == Design.prime: PrimeHomePage { // W3-prime
                hero: root.hero;
                rows: root.home-rows;
                loading: root.home-loading;
                error: root.home-error;
                focus-row: root.focus-row;
                focus-index: root.focus-index;
                ui: root.home-ui;
                version: root.version;
                event(k, v) => { root.home-event(k, v); }
                event-f(k, v) => { root.home-event-f(k, v); }
                card-clicked(r, i) => { root.card-clicked(r, i); }
                layout-changed(l) => { root.home-layout(l); }
                trailer-rect(x, y, w, h) => { root.home-trailer-rect(x, y, w, h); }
            }
            if root.page == Page.home && Theme.design == Design.plus: PlusHomePage { // W3-plus
                hero: root.hero;
                rows: root.home-rows;
                loading: root.home-loading;
                error: root.home-error;
                focus-row: root.focus-row;
                focus-index: root.focus-index;
                ui: root.home-ui;
                version: root.version;
                brands: root.plus-brands;
                event(k, v) => { root.home-event(k, v); }
                event-f(k, v) => { root.home-event-f(k, v); }
                card-clicked(r, i) => { root.card-clicked(r, i); }
                layout-changed(l) => { root.home-layout(l); }
            }
            if root.page == Page.player: PlayerPage {
                pv: root.pv; // W2-player
                cmd(n, v) => { root.player-cmd(n, v); }
            }
            if root.page == Page.tvmode: TvPage { }  // W2-tvui
            if root.page == Page.library: LibraryPage { } // W2-library
            if root.page == Page.soon: SoonPage {
                title: root.soon-title;
                focus-slot: root.simple-slot;
                back => { root.simple-back(); }
            }
            if root.page == Page.settings: AccountPage { } // W4-account (ersetzt SettingsPage, auch Verwaltung)
            if root.page == Page.detail && Theme.design != Design.plus: DetailPage { } // W2-detail
            if root.page == Page.detail && Theme.design == Design.plus: PlusTitlePage { } // W3-plus
            if root.page == Page.media: MediaPage { } // W4-media
            if root.page == Page.downloads: DownloadsPage { } // W5-downloads
            if root.page == Page.about: AboutPage {
                version: root.version;
                notices: root.notices;
                focus-slot: root.simple-slot;
                back => { root.simple-back(); }
            }
        }

        // W2-detail: Hovercard, Detail-Modal, Kontextmenü (unter der Titelleiste)
        DetailOverlays {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
        }

        // W3-picker: Kopfleiste auch auf der Detailseite (gleiche Komponente und Ereignisse wie auf der Startseite)
        if root.page == Page.detail: HomeChrome {
            x: 0px;
            y: bar.height / root.zf;
            width: parent.width;
            height: parent.height - bar.height / root.zf;
            ui: root.home-ui;
            version: root.version;
            gutter: Theme.gutter-at(self.width);
            header-h: Theme.t.header-h;
            scrolled: false;
            current: -1;
            focus-index: -1;
            event(k, v) => { root.home-event(k, v); }
            event-f(k, v) => { root.home-event-f(k, v); }
        }
        // W4-media: Mini-Player-Leiste über allen Seiten (außer Player und TV) und Overlays der Medienseiten
        if MediaUi.np-active && root.page != Page.player && root.page != Page.tvmode && root.page != Page.add-server && root.page != Page.login && root.page != Page.profiles: MediaBar {
            x: 0px;
            y: parent.height - self.height;
            width: parent.width;
            visible: MediaUi.bar-visible;
        }
        if root.page == Page.media || MediaUi.np-full: MediaOverlays {
            x: 0px;
            y: bar.height / root.zf;
            width: parent.width;
            height: parent.height - bar.height / root.zf;
        }
        // W5-downloads: Offline-Hinweis (unten links) und Download-Dialog
        if DlState.offline && root.page != Page.player && root.page != Page.tvmode && root.page != Page.add-server && root.page != Page.login && root.page != Page.profiles && root.page != Page.downloads: DlBanner {
            x: 20px;
            y: parent.height - self.height - 20px;
        }
        DlDialog {
            x: 0px;
            y: bar.height / root.zf;
            width: parent.width;
            height: parent.height - bar.height / root.zf;
        }
        } // zoomwrap

        // W3-retro: CRT, Boot, Terminal, Code-Regen (unter der Titelleiste)
        RetroFxLayer {
            x: 0px;
            y: bar.height;
            width: parent.width;
            height: parent.height - bar.height;
        }


        // W3-picker: Design-Auswahl über der Seite, unter der Titelleiste
        PickerOverlay {
            x: 0px;
            y: bar.height;
            width: parent.width;
            height: parent.height - bar.height;
        }

        bar := LfxTitleBar {
            show-logo: !(root.page == Page.home || root.page == Page.library || root.page == Page.detail); // W3-picker
            x: 0px;
            y: 0px;
            width: parent.width;
            mac: root.mac;
            maximized: root.is-maximized;
            opacity: root.page == Page.player && !root.pv.osd ? 0.0 : 1.0;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            drag-started => { root.drag-started(); }
            hit-changed(h) => { root.titlebar-hit(h); }
        }

        LfxToast {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 28px;
            shown: root.toast != "";
            kind: root.toast-kind;
            text: root.toast;
        }
    }
}
