import { Theme, Design } from "../theme/theme.slint";
import { LfxText } from "../components/text.slint";
import { LfxSkeleton, LfxSpinner } from "../components/feedback.slint";
import { HeroData } from "types.slint";
import { HRow, HomeLayout, HomeUi } from "home-types.slint";
import { HomeChrome } from "../components/home-chrome.slint";
import { HomeBillboard } from "../components/home-billboard.slint";
import { HomeRow } from "../components/home-row.slint";
import { DetailState } from "detail-state.slint"; // W2-detail

// Ambient-Verlauf (Web: `#lfx-ambient`): oben 35 %, bei 170 px 85 %, bei 55 % 70 %, unten transparent.
component AmbientFill inherits Rectangle {
    in property <color> c;
    background: @linear-gradient(180deg, root.c.with-alpha(0.35) 0%, root.c.with-alpha(0.85) 21%, root.c.with-alpha(0.7) 55%, root.c.with-alpha(0.0) 100%);
}

// Ein Stück des Seitenhintergrunds (Grundfarbe plus der passende Ausschnitt des Ambient-Verlaufs). Der
// Hintergrund besteht aus vier Stücken um das Billboard, damit dort die Video-Ebene (Trailer) durchscheint.
component BgPiece inherits Rectangle {
    in property <color> ambient;
    in property <length> page-w;
    in property <length> amb-y;
    in property <length> amb-h;
    clip: true;
    background: Theme.design == Design.retro ? Theme.t.retro-bg : Theme.t.bg;
    AmbientFill {
        x: -root.x;
        y: root.amb-y - root.y;
        width: root.page-w;
        height: root.amb-h;
        c: root.ambient;
    }
}

// Ecke, die der Radius des Billboards beim Trailer freigibt (Füllung nahe am Hintergrund).
component Corner inherits Path {
    in property <length> r;
    in property <int> which;
    width: root.r;
    height: root.r;
    viewbox-width: 18;
    viewbox-height: 18;
    commands: root.which == 0 ? "M 0 0 L 18 0 A 18 18 0 0 0 0 18 Z"
        : (root.which == 1 ? "M 18 0 L 18 18 A 18 18 0 0 0 0 0 Z"
        : (root.which == 2 ? "M 0 18 L 0 0 A 18 18 0 0 0 18 18 Z"
        : "M 18 18 L 0 18 A 18 18 0 0 0 18 0 Z"));
}

// LENZFLIX-Startseite. Fokus (von lfx-nav): focus-row -2 = Kopfleiste, -1 = Billboard-Knöpfe (0 Abspielen,
// 1 Weitere Infos), >= 0 = Zeile mit Kartenindex focus-index.
export component HomePage inherits Rectangle {
    in property <HeroData> hero;
    in property <[HRow]> rows;
    in property <bool> loading: false;
    in property <string> error;
    in property <int> focus-row: -1;
    in property <int> focus-index: 0;
    in property <HomeUi> ui;
    in property <string> version;
    callback event(string, int);
    callback event-f(string, float);
    callback card-clicked(int, int);
    callback layout-changed(HomeLayout);
    callback trailer-rect(length, length, length, length);

    property <length> gutter: Theme.gutter-at(root.width);
    property <int> n: Theme.cards-visible-at(root.width);
    property <length> gap: Theme.t.card-gap;
    property <length> card-w: (root.width - root.gutter - root.n * root.gap - Theme.t.card-peek) / root.n;
    property <length> card-h: root.card-w * 9 / 16;
    property <length> top-h: root.card-w * 0.7;
    property <length> head-h: 19px;
    property <length> row-h: root.head-h + Theme.t.row-title-gap + root.card-h + Theme.t.row-gap;
    property <length> top-extra: root.top-h - root.card-h;
    property <length> header-h: Theme.t.header-h;
    property <length> bb-x: root.gutter;
    property <length> bb-y: root.header-h + 6px;
    property <length> bb-w: root.width - 2 * root.gutter;
    property <length> bb-h: min(root.bb-w / Theme.t.billboard-ratio, root.height * 0.8);
    property <length> rows-top: root.bb-y + root.bb-h + 24px;
    property <length> btn-h: Theme.t.btn-h;
    property <length> play-y: root.bb-y + root.bb-h - root.btn-h - 27px;
    property <int> tall-total: root.rows.length > 0 ? root.rows[root.rows.length - 1].tall-before + (root.rows[root.rows.length - 1].top10 ? 1 : 0) : 0;
    property <length> scroll: -flick.content-y;
    property <bool> scrolled: root.scroll > 8px;
    property <color> amb: root.ui.ambient;
    animate amb { duration: 600ms; easing: Theme.t.ease; }

    out property <HomeLayout> layout: {
        width: root.width,
        header-h: root.header-h,
        gutter: root.gutter,
        bb-x: root.bb-x,
        bb-y: root.bb-y,
        bb-w: root.bb-w,
        bb-h: root.bb-h,
        play-x: root.bb-x + 28px,
        play-y: root.play-y,
        play-w: 178px,
        info-x: root.bb-x + 28px + 178px + Theme.t.btn-gap,
        info-w: 184px,
        btn-h: root.btn-h,
        rows-top: root.rows-top,
        row-h: root.row-h,
        top-extra: root.top-extra,
        pitch: root.card-w + root.gap,
        card-w: root.card-w,
        card-h: root.card-h,
        top-card-h: root.top-h,
        head-h: root.head-h + Theme.t.row-title-gap,
    };
    changed layout => { root.layout-changed(root.layout); }
    init => { root.layout-changed(root.layout); }

    // Video-Rechteck des Billboards in Fensterkoordinaten (folgt dem Scrollen)
    property <length> bb-ax: bb.absolute-position.x;
    property <length> bb-ay: bb.absolute-position.y;
    function emit-rect() { root.trailer-rect(root.bb-ax, root.bb-ay, root.bb-w, root.bb-h); }
    changed bb-ax => { root.emit-rect(); }
    changed bb-ay => { root.emit-rect(); }
    changed bb-w => { root.emit-rect(); }
    changed bb-h => { root.emit-rect(); }

    function row-y(r: int) -> length {
        return root.rows-top + r * root.row-h + root.rows[r].tall-before * root.top-extra;
    }
    function scroll-to-focus() {
        if (root.focus-row < 0 || root.focus-row >= root.rows.length) {
            flick.content-y = 0px;
        } else {
            if (root.row-y(root.focus-row) - 40px < root.scroll) {
                flick.content-y = -max(0px, root.row-y(root.focus-row) - 40px);
            } else if (root.row-y(root.focus-row) + root.row-h + (root.rows[root.focus-row].top10 ? root.top-extra : 0px) > root.scroll + flick.height) {
                flick.content-y = -(root.row-y(root.focus-row) + root.row-h + (root.rows[root.focus-row].top10 ? root.top-extra : 0px) - flick.height + 10px);
            }
        }
    }
    changed focus-row => { root.scroll-to-focus(); }

    // Hintergrund in vier Stücken um das Billboard (Loch für den Trailer)
    property <length> hole-y: root.bb-y - root.scroll;
    BgPiece {
        x: 0px;
        y: 0px;
        width: root.width;
        height: max(0px, min(root.height, root.hole-y));
        page-w: root.width;
        amb-y: -root.scroll;
        amb-h: min(820px, root.height);
        ambient: root.amb;
    }
    BgPiece {
        x: 0px;
        y: max(0px, root.hole-y + root.bb-h);
        width: root.width;
        height: max(0px, root.height - self.y);
        page-w: root.width;
        amb-y: -root.scroll;
        amb-h: min(820px, root.height);
        ambient: root.amb;
    }
    BgPiece {
        x: 0px;
        y: max(0px, root.hole-y);
        width: root.bb-x;
        height: max(0px, min(root.height, root.hole-y + root.bb-h) - self.y);
        page-w: root.width;
        amb-y: -root.scroll;
        amb-h: min(820px, root.height);
        ambient: root.amb;
    }
    BgPiece {
        x: root.bb-x + root.bb-w;
        y: max(0px, root.hole-y);
        width: root.width - self.x;
        height: max(0px, min(root.height, root.hole-y + root.bb-h) - self.y);
        page-w: root.width;
        amb-y: -root.scroll;
        amb-h: min(820px, root.height);
        ambient: root.amb;
    }

    flick := Flickable {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        content-width: root.width;
        content-height: root.rows-top + max(1, root.rows.length) * root.row-h + root.tall-total * root.top-extra + 80px;
        animate content-y { duration: Theme.t.dur * 2; easing: Theme.t.ease-out; }

        bb := HomeBillboard {
            x: root.bb-x;
            y: root.bb-y;
            width: root.bb-w;
            height: root.bb-h;
            hero: root.hero;
            ui: root.ui;
            badge: root.ui.badge;
            primary-text: root.ui.primary;
            focus-index: root.focus-row == -1 ? root.focus-index : -1;
            play => { root.event("hero-play", 0); }
            info => { root.event("hero-info", 0); }
            mute => { root.event("mute", 0); }
            dot(d) => { root.event("dot", d); }
        }
        if root.hero.has-item && !root.hero.has-backdrop && !root.ui.trailer-on: LfxSpinner {
            x: root.bb-x + (root.bb-w - self.width) / 2;
            y: root.bb-y + (root.bb-h - self.height) / 2;
            running: root.loading;
        }
        if !root.hero.has-item && root.loading: LfxSpinner {
            x: root.bb-x + (root.bb-w - self.width) / 2;
            y: root.bb-y + (root.bb-h - self.height) / 2;
        }

        for row[r] in root.rows: HomeRow {
            x: 0px;
            y: root.rows-top + r * root.row-h + row.tall-before * root.top-extra;
            width: root.width;
            height: root.row-h + (row.top10 ? root.top-extra : 0px);
            title: row.title;
            items: row.items;
            top10: row.top10;
            gutter: root.gutter;
            n: root.n;
            gap: root.gap;
            card-w: root.card-w;
            card-h: row.top10 ? root.top-h : root.card-h;
            focused-index: r == root.focus-row ? root.focus-index : -1;
            card-clicked(i) => { root.card-clicked(r, i); }
            card-hover(i, h, x, y, w, ch) => { DetailState.card-hover(r, i, h, x, y, w, ch); } // W2-detail
            card-context(i, x, y) => { DetailState.card-context(r, i, x, y); } // W2-detail
            visible-changed(f) => { root.event("row-view", r * 1000 + f); }
        }

        if root.rows.length == 0 && root.loading: Rectangle {
            y: root.rows-top;
            width: root.width;
            height: 3 * root.row-h;
            for s in 3: Rectangle {
                y: s * root.row-h;
                height: root.row-h;
                LfxSkeleton {
                    x: root.gutter;
                    y: root.head-h + Theme.t.row-title-gap;
                    width: root.card-w * 4 + 3 * root.gap;
                    height: root.card-h;
                    radius: Theme.t.card-radius;
                }
            }
        }
        if root.rows.length == 0 && !root.loading && root.error != "": LfxText {
            y: root.rows-top + 8px;
            x: root.gutter;
            width: root.width - 2 * root.gutter;
            text: root.error;
            color: Theme.t.text-muted;
            wrap: word-wrap;
        }
    }

    // Ecken des Trailer-Lochs
    if root.ui.trailer-on: Corner {
        x: root.bb-x;
        y: root.hole-y;
        r: Theme.t.billboard-radius;
        which: 0;
        fill: Theme.t.bg.mix(root.amb, 0.62);
    }
    if root.ui.trailer-on: Corner {
        x: root.bb-x + root.bb-w - Theme.t.billboard-radius;
        y: root.hole-y;
        r: Theme.t.billboard-radius;
        which: 1;
        fill: Theme.t.bg.mix(root.amb, 0.62);
    }
    if root.ui.trailer-on: Corner {
        x: root.bb-x;
        y: root.hole-y + root.bb-h - Theme.t.billboard-radius;
        r: Theme.t.billboard-radius;
        which: 2;
        fill: Theme.t.bg.mix(root.amb, 0.3);
    }
    if root.ui.trailer-on: Corner {
        x: root.bb-x + root.bb-w - Theme.t.billboard-radius;
        y: root.hole-y + root.bb-h - Theme.t.billboard-radius;
        r: Theme.t.billboard-radius;
        which: 3;
        fill: Theme.t.bg.mix(root.amb, 0.3);
    }

    HomeChrome { // Kopfleiste und Menüs (geteilt mit den Bibliotheksseiten)
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        ui: root.ui;
        version: root.version;
        gutter: root.gutter;
        header-h: root.header-h;
        scrolled: root.scrolled;
        focus-index: root.focus-row == -2 ? root.focus-index : -1;
        event(k, v) => { root.event(k, v); }
        event-f(k, v) => { root.event-f(k, v); }
    }
}
