// W4-account: Konto, Einstellungen und Verwaltung in einer Hostseite (Seitenleiste + Inhaltsliste).
// Rust (lfx-app/src/account*.rs) hält Zustand und Fokus und setzt `AccountState`; die Oberfläche meldet nur Ereignisse
// über `AccountState.event(art, a, b)`: "side" (Seitenleiste angeklickt), "row" (Zeile angeklickt), "adjust"
// (Auswahl/Schalter ändern: Zeile, Richtung), "accept" (Eingabe bestätigt), "confirm" (0 abbrechen, 1 bestätigen).
//
// Zeilenarten (AcRow.kind): 0 Überschrift, 1 Schalter, 2 Auswahl, 3 Knopf, 4 Eingabefeld, 5 Info (Name/Wert),
// 6 Listeneintrag (Titel, Zweitzeile, Wert rechts), 7 Hinweistext, 8 Untertitel-Vorschau.
// Alle Zeilen sind gleich hoch (ROW-H), damit der Fokus die Liste deterministisch scrollen kann.
import { Theme, Design } from "../theme/theme.slint";
import { ButtonKind } from "../components/types.slint";
import { LfxText } from "../components/text.slint";
import { LfxButton } from "../components/button.slint";
import { LfxFocusRing } from "../components/focus-ring.slint";
import { LfxSpinner } from "../components/feedback.slint";

export struct AcRow {
    kind: int,
    label: string,
    value: string,
    hint: string,
    on: bool,
    danger: bool,
    enabled: bool,
    secret: bool,
}

export global AccountState {
    in property <string> title: "Einstellungen";
    in property <string> subtitle;
    // Pfad der Unteransicht („Benutzer › Name“), leer im Wurzelzustand
    in property <string> crumb;
    in property <[string]> sections;
    in property <int> section-current: 0;
    in property <[AcRow]> rows;
    // 0 Seitenleiste, 1 Inhalt
    in property <int> focus-zone: 0;
    in property <int> focus-row: 0;
    in property <int> editing: -1;
    in-out property <string> edit-text;
    in property <int> edit-tick: 0;
    in property <bool> loading: false;
    in property <string> status;
    in property <bool> status-error: false;
    in property <bool> confirm-open: false;
    in property <string> confirm-text;
    in property <string> confirm-yes: "Bestätigen";
    in property <int> confirm-focus: 0;
    // Untertitel-Vorschau: Größe in Pixeln, Farbe, Hintergrund (0 keiner, 1 Schatten, 2 Kasten)
    in property <length> preview-size: 18px;
    in property <color> preview-color: #ffffff;
    in property <int> preview-bg: 1;
    callback event(string, int, int);
}

global Dim {
    out property <length> row-h: 56px;
    out property <length> side-item-h: 46px;
}

component AccentText inherits Text {
    color: Theme.design == Design.retro ? Theme.t.retro-amber : Theme.t.text;
    font-family: Theme.t.font-family;
    font-size: Theme.t.fs-body;
}

// Ein-/Aus-Schalter.
component Switch inherits Rectangle {
    in property <bool> on;
    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? (Theme.design == Design.retro ? Theme.t.retro-amber : Theme.t.accent) : #ffffff30;
    animate background { duration: Theme.t.dur-fast; }
    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.design == Design.retro && root.on ? Theme.t.retro-ink : #ffffff;
        animate x { duration: Theme.t.dur-fast; }
    }
}

// Eingabekasten eines Feldes: zeigt den Wert, im Bearbeiten-Zustand ein Textfeld.
component FieldBox inherits Rectangle {
    in property <bool> editing;
    in-out property <string> text;
    in property <int> tick;
    in property <bool> secret;
    in property <string> shown;
    in property <bool> is-placeholder;
    in property <color> fg;
    callback accepted();
    changed tick => {
        if root.editing {
            input.focus();
        }
    }
    border-radius: Theme.design == Design.retro ? 2px : 6px;
    background: Theme.t.jf-filled-input-bg;
    border-width: 1px;
    border-color: root.editing ? (Theme.design == Design.retro ? Theme.t.retro-amber : #ffffff) : Theme.t.border;
    input := TextInput {
        x: 10px;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - 20px;
        visible: root.editing;
        text <=> root.text;
        input-type: root.secret ? InputType.password : InputType.text;
        font-family: Theme.t.font-family;
        font-size: Theme.t.fs-body;
        color: Theme.design == Design.retro ? Theme.t.retro-amber : Theme.t.text;
        single-line: true;
        accepted => { root.accepted(); }
    }
    if !root.editing: AccentText {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.shown;
        color: root.is-placeholder ? Theme.t.text-soft : root.fg;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Eine Zeile der Inhaltsliste.
component RowView inherits Rectangle {
    in property <AcRow> rd;
    in property <int> index;
    in property <bool> focused;
    in property <bool> editing;
    in-out property <string> edit-text;
    in property <int> edit-tick;
    callback clicked();
    callback adjust(int);
    callback accepted();

    property <bool> retro: Theme.design == Design.retro;
    property <bool> is-card: root.rd.kind != 0 && root.rd.kind != 7;
    property <color> fg: !root.rd.enabled ? Theme.t.text-soft : (root.rd.danger ? (root.retro ? Theme.t.retro-hot : Theme.t.red) : (root.retro ? Theme.t.retro-amber : Theme.t.text));

    height: Dim.row-h;
    // Kartenfläche
    card := Rectangle {
        x: 0px;
        y: 4px;
        width: parent.width;
        height: parent.height - 8px;
        border-radius: root.retro ? 2px : 8px;
        visible: root.is-card;
        background: root.rd.kind == 3
            ? (root.rd.danger ? (root.retro ? Theme.t.retro-panel : Theme.t.glass) : Theme.t.glass)
            : (root.retro ? Theme.t.retro-panel : Theme.t.surface);
        border-width: root.retro ? 1px : 0px;
        border-color: Theme.t.retro-line;
    }

    // Überschrift
    if root.rd.kind == 0: AccentText {
        x: 4px;
        y: 0px;
        width: parent.width - 8px;
        height: parent.height - 6px;
        text: root.retro ? "> " + root.rd.label : root.rd.label;
        font-size: 13px;
        font-weight: 700;
        color: Theme.t.text-muted;
        vertical-alignment: bottom;
        overflow: elide;
    }

    // Hinweistext
    if root.rd.kind == 7: AccentText {
        x: 4px;
        width: parent.width - 8px;
        height: parent.height;
        text: root.rd.label;
        font-size: 12px;
        color: Theme.t.text-soft;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }

    // Schalter
    if root.rd.kind == 1: Rectangle {
        AccentText {
            x: 16px;
            y: 0px;
            width: parent.width - 100px;
            height: parent.height;
            text: root.rd.label;
            color: root.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        Switch {
            x: parent.width - self.width - 16px;
            y: (parent.height - self.height) / 2;
            on: root.rd.on;
            opacity: root.rd.enabled ? 1.0 : 0.4;
        }
    }

    // Auswahl
    if root.rd.kind == 2: Rectangle {
        AccentText {
            x: 16px;
            width: parent.width * 0.5 - 16px;
            height: parent.height;
            text: root.rd.label;
            color: root.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        AccentText {
            x: parent.width * 0.5;
            width: parent.width * 0.5 - 16px;
            height: parent.height;
            text: (root.focused ? "‹  " : "") + root.rd.value + (root.focused ? "  ›" : "");
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.fg;
            font-weight: 600;
            overflow: elide;
        }
    }

    // Knopf
    if root.rd.kind == 3: AccentText {
        width: parent.width;
        height: parent.height;
        text: root.retro ? "[ " + root.rd.label + " ]" : root.rd.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.fg;
        font-weight: 600;
        overflow: elide;
    }

    // Eingabefeld
    if root.rd.kind == 4: Rectangle {
        AccentText {
            x: 16px;
            width: parent.width * 0.34;
            height: parent.height;
            text: root.rd.label;
            color: root.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        FieldBox {
            x: parent.width * 0.36;
            y: 10px;
            width: parent.width * 0.64 - 14px;
            height: parent.height - 20px;
            editing: root.editing;
            text <=> root.edit-text;
            tick: root.edit-tick;
            secret: root.rd.secret;
            shown: root.rd.value == "" ? root.rd.hint : (root.rd.secret ? "••••••••" : root.rd.value);
            is-placeholder: root.rd.value == "";
            fg: root.fg;
            accepted => { root.accepted(); }
        }
    }

    // Info (Name links, Wert rechts)
    if root.rd.kind == 5: Rectangle {
        AccentText {
            x: 16px;
            width: parent.width * 0.4 - 16px;
            height: parent.height;
            text: root.rd.label;
            color: Theme.t.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        AccentText {
            x: parent.width * 0.4;
            width: parent.width * 0.6 - 16px;
            height: parent.height;
            text: root.rd.value;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.fg;
            overflow: elide;
        }
    }

    // Listeneintrag
    if root.rd.kind == 6: Rectangle {
        AccentText {
            x: 16px;
            y: root.rd.hint == "" ? (parent.height - self.height) / 2 : 8px;
            width: parent.width - 32px - (root.rd.value == "" ? 0px : min(190px, parent.width * 0.3));
            height: 22px;
            text: root.rd.label;
            color: root.fg;
            font-weight: 600;
            overflow: elide;
        }
        if root.rd.hint != "": AccentText {
            x: 16px;
            y: 30px;
            width: parent.width - 32px - (root.rd.value == "" ? 0px : min(190px, parent.width * 0.3));
            height: 16px;
            text: root.rd.hint;
            font-size: 12px;
            color: Theme.t.text-muted;
            overflow: elide;
        }
        if root.rd.value != "": AccentText {
            x: parent.width - min(190px, parent.width * 0.3) - 16px;
            width: min(190px, parent.width * 0.3);
            height: parent.height;
            text: root.rd.value;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: Theme.t.text-muted;
            font-size: 13px;
            overflow: elide;
        }
    }

    // Untertitel-Vorschau
    if root.rd.kind == 8: Rectangle {
        x: 0px;
        y: 4px;
        width: parent.width;
        height: parent.height - 8px;
        border-radius: 8px;
        background: #3a3f4c;
        clip: true;
        if AccountState.preview-bg == 2: Rectangle {
            x: (parent.width - lbl.preferred-width) / 2 - 8px;
            y: (parent.height - lbl.preferred-height) / 2 - 2px;
            width: lbl.preferred-width + 16px;
            height: lbl.preferred-height + 4px;
            background: #000000b0;
            border-radius: 3px;
        }
        if AccountState.preview-bg == 1: Text {
            x: 0px;
            y: 2px;
            width: parent.width;
            height: parent.height;
            text: root.rd.label;
            font-size: AccountState.preview-size;
            font-weight: 700;
            color: #000000;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: 0.8;
        }
        lbl := Text {
            width: parent.width;
            height: parent.height;
            text: root.rd.label;
            font-family: Theme.t.font-family;
            font-size: AccountState.preview-size;
            font-weight: 700;
            color: AccountState.preview-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.rd.kind == 3 || root.rd.kind == 1 || root.rd.kind == 2 || root.rd.kind == 4 || root.rd.kind == 6: LfxFocusRing {
        x: 0px;
        y: 4px;
        width: parent.width;
        height: parent.height - 8px;
        active: root.focused;
        radius: root.retro ? 2px : 8px;
    }

    if root.rd.kind >= 1 && root.rd.kind != 5 && root.rd.kind != 7 && root.rd.kind != 8: TouchArea {
        enabled: root.rd.enabled;
        clicked => {
            if root.rd.kind == 2 {
                root.adjust(self.mouse-x > self.width / 2 ? 1 : -1);
            } else {
                root.clicked();
            }
        }
    }
}

// Seite. Fokus und Logik liegen in Rust; hier nur Darstellung.
export component AccountPage inherits Rectangle {
    property <bool> compact: root.width < 860px;
    property <length> gutter: root.width < 700px ? 16px : 40px;
    property <length> side-w: root.compact ? 190px : 250px;
    property <length> head-h: 96px;
    property <bool> retro: Theme.design == Design.retro;

    // Kopf
    AccentText {
        x: root.gutter;
        y: 18px;
        width: parent.width - 2 * root.gutter - 60px;
        height: 40px;
        text: AccountState.title;
        font-size: 30px;
        font-weight: 700;
        overflow: elide;
    }
    AccentText {
        x: root.gutter;
        y: 58px;
        width: parent.width - 2 * root.gutter - 60px;
        height: 22px;
        text: AccountState.crumb != "" ? AccountState.subtitle + "  ›  " + AccountState.crumb : AccountState.subtitle;
        color: Theme.t.text-muted;
        font-size: 14px;
        overflow: elide;
    }
    if AccountState.loading: LfxSpinner {
        x: parent.width - root.gutter - self.width;
        y: 26px;
        size: 26px;
    }

    // Seitenleiste
    Rectangle {
        x: root.gutter;
        y: root.head-h;
        width: root.side-w;
        height: parent.height - root.head-h - 12px;
        for name[i] in AccountState.sections: Rectangle {
            y: i * Dim.side-item-h;
            height: Dim.side-item-h - 4px;
            width: parent.width;
            property <bool> current: AccountState.section-current == i;
            property <bool> foc: current && AccountState.focus-zone == 0;
            background: current ? (root.retro ? Theme.t.retro-panel : Theme.t.glass-hover) : transparent;
            border-radius: root.retro ? 2px : 8px;
            AccentText {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                text: root.retro ? (current ? "> " : "  ") + name : name;
                font-weight: current ? 700 : 400;
                color: current ? (root.retro ? Theme.t.retro-amber : Theme.t.text) : Theme.t.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
            LfxFocusRing { active: foc; radius: root.retro ? 2px : 8px; }
            TouchArea { clicked => { AccountState.event("side", i, 0); } }
        }
    }

    // Inhalt
    Rectangle {
        x: root.gutter + root.side-w + 24px;
        y: root.head-h;
        width: min(parent.width - self.x - root.gutter, 860px);
        height: parent.height - root.head-h - 12px;
        clip: true;

        if AccountState.status != "": AccentText {
            y: 0px;
            width: parent.width;
            height: 22px;
            text: AccountState.status;
            color: AccountState.status-error ? Theme.t.red : Theme.t.text-muted;
            font-size: 13px;
            overflow: elide;
        }

        flick := Flickable {
            y: AccountState.status != "" ? 26px : 0px;
            width: parent.width;
            height: parent.height - self.y;
            content-height: AccountState.rows.length * Dim.row-h + 12px;
            content-width: parent.width;

            for r[i] in AccountState.rows: RowView {
                y: i * Dim.row-h;
                width: flick.width;
                rd: r;
                index: i;
                focused: AccountState.focus-zone == 1 && AccountState.focus-row == i && !AccountState.confirm-open;
                editing: AccountState.editing == i;
                edit-text <=> AccountState.edit-text;
                edit-tick: AccountState.edit-tick;
                clicked => { AccountState.event("row", i, 0); }
                adjust(d) => { AccountState.event("adjust", i, d); }
                accepted => { AccountState.event("accept", i, 0); }
            }
        }
    }

    property <int> fr: AccountState.focus-row;
    property <int> nrows: AccountState.rows.length;
    changed fr => { root.keep-visible(); }
    changed nrows => { root.keep-visible(); }
    function keep-visible() {
        if AccountState.focus-zone != 1 {
            return;
        }
        if AccountState.focus-row * Dim.row-h < -flick.content-y {
            flick.content-y = -(AccountState.focus-row * Dim.row-h);
        }
        if (AccountState.focus-row + 1) * Dim.row-h > -flick.content-y + flick.height {
            flick.content-y = -((AccountState.focus-row + 1) * Dim.row-h - flick.height + 6px);
        }
    }

    // Bestätigungsdialog
    if AccountState.confirm-open: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: min(460px, parent.width - 48px);
            height: 190px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 20px;
            background: root.retro ? Theme.t.retro-bg : Theme.t.surface-2;
            border-radius: root.retro ? 2px : Theme.t.modal-radius;
            border-width: 1px;
            border-color: root.retro ? Theme.t.retro-amber : Theme.t.border;
            AccentText {
                x: 24px;
                y: 22px;
                width: parent.width - 48px;
                height: 80px;
                text: AccountState.confirm-text;
                wrap: word-wrap;
                font-size: 16px;
            }
            LfxButton {
                x: 24px;
                y: parent.height - self.height - 22px;
                width: (parent.width - 60px) / 2;
                kind: ButtonKind.secondary;
                text: "Abbrechen";
                focused: AccountState.confirm-focus == 0;
                clicked => { AccountState.event("confirm", 0, 0); }
            }
            LfxButton {
                x: 24px + (parent.width - 60px) / 2 + 12px;
                y: parent.height - self.height - 22px;
                width: (parent.width - 60px) / 2;
                kind: ButtonKind.primary;
                text: AccountState.confirm-yes;
                focused: AccountState.confirm-focus == 1;
                clicked => { AccountState.event("confirm", 1, 0); }
            }
        }
    }
}
