import { Theme, Design } from "../theme/theme.slint";
import { ButtonKind } from "../components/types.slint";
import { LfxText } from "../components/text.slint";
import { LfxButton } from "../components/button.slint";
import { LfxSlider } from "../components/controls.slint";
import { LfxSpinner } from "../components/feedback.slint";
import { Icons } from "../icons.slint";

// Player-Oberfläche über dem Video: Titel, Zurück, Play/Pause, ±10 s und Spulleiste mit Zeit.
// Die Seite ist durchsichtig (das Video liegt in einer eigenen Ebene darunter).
// Slots (von lfx-nav): 0 Zurück, 1 −10 s, 2 Play/Pause, 3 +10 s, 4 Spulleiste.
export component PlayerPage inherits Rectangle {
    in property <string> title;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> progress: 0.0;
    in property <float> buffered: 0.0;
    in property <bool> paused: false;
    in property <bool> osd: true;
    in property <bool> buffering: false;
    in property <string> note;
    in property <int> focus-slot: 2;
    callback toggle-pause();
    callback seek-by(float);
    callback seek-to(float);
    callback leave();
    callback activity();

    background: transparent;

    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.activity(); }
        }
        clicked => { root.toggle-pause(); }
    }

    if root.note != "": Rectangle {
        background: Theme.t.bg;
        LfxText {
            width: 100%;
            height: 100%;
            text: root.note;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 22px;
            wrap: word-wrap;
        }
    }

    if root.buffering: LfxSpinner {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 48px;
    }

    if root.osd: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 110px;
        background: @linear-gradient(180deg, #000000b0 0%, #00000000 100%);
        LfxButton {
            x: 20px;
            y: 14px;
            width: Theme.t.btn-h;
            kind: ButtonKind.round;
            icon: Icons.back;
            has-icon: true;
            focused: root.focus-slot == 0;
            clicked => { root.leave(); }
        }
        LfxText {
            x: 20px + Theme.t.btn-h + 16px;
            y: 14px;
            height: Theme.t.btn-h;
            width: parent.width - 20px - Theme.t.btn-h - 16px - 20px;
            text: root.title;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.osd: Rectangle {
        x: 0px;
        y: parent.height - self.height;
        width: parent.width;
        height: 150px;
        background: @linear-gradient(180deg, #00000000 0%, #000000c0 100%);
        LfxText {
            x: 24px;
            y: 30px;
            width: 70px;
            height: 24px;
            text: root.pos-text;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
        LfxSlider {
            x: 24px + 70px;
            y: 30px;
            width: parent.width - 2 * 24px - 2 * 70px;
            value: root.progress;
            buffered: root.buffered;
            focused: root.focus-slot == 4;
            seeked(v) => { root.seek-to(v); }
        }
        LfxText {
            x: parent.width - 24px - 70px;
            y: 30px;
            width: 70px;
            height: 24px;
            text: root.dur-text;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: 0px;
            y: 70px;
            width: parent.width;
            height: Theme.t.btn-h;
            alignment: center;
            spacing: 16px;
            LfxButton {
                kind: ButtonKind.secondary;
                text: "−10 s";
                focused: root.focus-slot == 1;
                clicked => { root.seek-by(-10.0); }
            }
            LfxButton {
                width: Theme.t.btn-h;
                kind: ButtonKind.round;
                icon: root.paused ? Icons.play : Icons.pause;
                has-icon: true;
                focused: root.focus-slot == 2;
                clicked => { root.toggle-pause(); }
            }
            LfxButton {
                kind: ButtonKind.secondary;
                text: "+10 s";
                focused: root.focus-slot == 3;
                clicked => { root.seek-by(10.0); }
            }
        }
    }
}
