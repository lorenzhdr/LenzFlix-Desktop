// W2-tvui: TV-Modus-Seite (Route TvMode). Nachbau von src/css/tvmode/* des Web-Themes:
// Video links oben mit Info darunter, Senderliste rechts („Jetzt im TV“), Programm-Raster („Programm“),
// Info-Karte, Zustandskarten, Ziffern- und Zapp-Einblendung. Das Video liegt in einer eigenen Ebene unter der UI;
// der Player-Kasten ist ein durchsichtiges Loch, um das herum die Seite ihren Hintergrund malt.
import { Theme, Design } from "../theme/theme.slint";
import { LfxText } from "../components/text.slint";
import { LfxIcon } from "../components/icon.slint";
import { LfxSpinner } from "../components/feedback.slint";
import { LfxSlider } from "../components/controls.slint";
import { Icons } from "../icons.slint";
import { TvState, TvTheme, TvChanRow, TvCellData, TvEpgRowData, TvMark } from "tvui-types.slint";

component TvBadge inherits Rectangle {
    in property <color> fill;
    in property <color> ink;
    in property <string> text;
    in property <length> fs: 11px;
    height: 20px;
    width: lbl.preferred-width + 14px;
    border-radius: Theme.design == Design.retro ? 0px : 6px;
    background: root.fill;
    lbl := Text {
        x: 7px;
        y: 0px;
        height: 100%;
        text: root.text;
        color: root.ink;
        font-family: Theme.t.font-family;
        font-size: root.fs;
        font-weight: 800;
        vertical-alignment: center;
    }
}

component TvPill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> accent;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked();
    height: 36px;
    width: row.preferred-width + 28px;
    border-radius: Theme.design == Design.retro ? 0px : 18px;
    border-width: root.accent || root.active ? 0px : 1px;
    border-color: Theme.t.border;
    background: root.accent ? (ta.has-hover ? Theme.t.red-hover : TvTheme.accent)
        : root.active ? Theme.t.text
        : (ta.has-hover ? Theme.t.surface-2 : transparent);
    row := HorizontalLayout {
        spacing: 8px;
        alignment: center;
        if root.has-icon: LfxIcon {
            source: root.icon;
            size: 18px;
            tint: root.active ? Theme.t.bg : Theme.t.text;
            y: (parent.height - self.height) / 2;
        }
        LfxText {
            text: root.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.accent ? TvTheme.accent-ink : (root.active ? Theme.t.bg : Theme.t.text-body);
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Runder Symbolknopf in der Bedienleiste.
component TvIconBtn inherits Rectangle {
    in property <image> icon;
    in property <bool> pressed-state: false;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: root.pressed-state ? #ffffff26 : (ta.has-hover ? #ffffff1a : transparent);
    LfxIcon {
        source: root.icon;
        size: 24px;
        x: 8px;
        y: 8px;
        tint: Theme.t.text;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TvListRow inherits Rectangle {
    in property <TvChanRow> d;
    in property <bool> current;
    callback clicked();
    height: 83px;
    border-radius: Theme.design == Design.retro ? 0px : 8px;
    background: root.current ? (ta.has-hover ? Theme.t.surface-3 : Theme.t.surface-2) : (ta.has-hover ? Theme.t.surface : transparent);
    Rectangle {
        x: 0px;
        width: 3px;
        background: root.current ? TvTheme.accent : transparent;
    }
    LfxText {
        x: 6px;
        y: 0px;
        width: 30px;
        height: 100%;
        text: root.d.no;
        font-size: Theme.t.fs-meta;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: root.current ? Theme.t.text : Theme.t.text-muted;
    }
    Rectangle {
        x: 46px;
        y: 8px;
        width: 120px;
        height: 67px;
        border-radius: 6px;
        clip: true;
        background: @linear-gradient(135deg, root.d.color 0%, root.d.color.darker(0.5) 100%);
        opacity: root.d.dim ? 0.55 : 1.0;
        Text {
            width: 100%;
            height: 100%;
            text: root.d.short;
            color: root.d.ink;
            font-family: Theme.t.font-family;
            font-size: 17px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 178px;
        y: 8px;
        width: parent.width - 178px - 12px;
        height: 67px;
        clip: true;
        LfxText {
            y: 0px;
            width: 100%;
            height: 34px;
            text: root.d.title;
            wrap: word-wrap;
            font-size: Theme.t.fs-body;
            font-weight: Theme.t.fw-row-title;
            color: root.d.dim ? Theme.t.text-soft : Theme.t.text;
            overflow: elide;
        }
        LfxText {
            y: 34px;
            width: 100%;
            height: 16px;
            text: root.d.sub;
            font-size: 12px;
            color: Theme.t.text-muted;
            overflow: elide;
        }
        LfxText {
            y: 49px;
            width: 100%;
            height: 16px;
            text: root.d.next;
            font-size: 12px;
            color: Theme.t.text-muted;
            overflow: elide;
        }
        Rectangle {
            y: 65px;
            height: 2px;
            background: Theme.t.surface-3;
            Rectangle {
                x: 0px;
                width: parent.width * clamp(root.d.progress, 0.0, 1.0);
                background: TvTheme.accent;
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TvCell inherits Rectangle {
    in property <TvCellData> d;
    in property <length> scroll-x;
    in property <length> row-h: 54px;
    callback clicked();
    x: root.d.x + 1px;
    y: 2px;
    width: max(root.d.w - 2px, 2px);
    height: root.row-h - 4px;
    border-radius: Theme.design == Design.retro ? 0px : 8px;
    clip: true;
    background: root.d.kind == 0
        ? (root.d.current ? Theme.t.surface-3 : (root.d.past ? Theme.t.surface : Theme.t.surface-2))
        : (root.d.current ? Theme.t.surface : #ffffff0a);
    if root.d.current && root.d.progress > 0: Rectangle {
        x: 0px;
        width: parent.width * clamp(root.d.progress, 0.0, 1.0);
        background: #ffffff1f;
    }
    if ta.has-hover: Rectangle { background: #ffffff14; }
    if root.d.size < 2: Rectangle {
        x: max(10px, root.scroll-x - root.d.x + 8px);
        width: max(parent.width - self.x - 6px, 1px);
        LfxText {
            y: root.d.size == 1 ? (parent.height - self.height) / 2 : 6px;
            width: 100%;
            height: 18px;
            text: root.d.title;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            color: root.d.kind == 0 ? Theme.t.text : Theme.t.text-soft;
        }
        if root.d.size == 0: LfxText {
            y: 24px;
            width: 100%;
            height: 16px;
            text: root.d.time;
            font-size: 11px;
            color: Theme.t.text-muted;
            overflow: elide;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TvEpg inherits Rectangle {
    property <length> chan-w: 138px;
    property <length> scale-h: 34px;
    property <length> row-h: 54px;
    background: Theme.t.bg-deep;
    border-radius: Theme.design == Design.retro ? 0px : 10px;
    clip: true;

    fl := Flickable {
        x: root.chan-w;
        y: root.scale-h;
        width: parent.width - root.chan-w;
        height: parent.height - root.scale-h;
        content-width: TvState.epg-total-w;
        content-height: TvState.epg-rows.length * root.row-h;
        content-x <=> TvState.epg-x;
        content-y <=> TvState.epg-y;
        for row[ri] in TvState.epg-rows: Rectangle {
            x: 0px;
            y: ri * root.row-h;
            width: TvState.epg-total-w;
            height: root.row-h;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #ffffff0a;
            }
            for cell[ci] in row.cells: TvCell {
                d: cell;
                scroll-x: -TvState.epg-x;
                clicked => { TvState.cell-clicked(ri, ci); }
            }
        }
        if TvState.now-visible: Rectangle {
            x: TvState.now-x - 1px;
            y: 0px;
            width: 2px;
            height: TvState.epg-rows.length * root.row-h;
            background: TvTheme.accent;
        }
    }
    // Zeitleiste (oben, scrollt nur waagerecht mit)
    Rectangle {
        x: root.chan-w;
        y: 0px;
        width: parent.width - root.chan-w;
        height: root.scale-h;
        clip: true;
        background: Theme.t.bg-deep;
        for m in TvState.scale: Rectangle {
            x: TvState.epg-x + m.x;
            width: 70px;
            height: parent.height;
            Rectangle {
                width: 1px;
                background: m.half ? transparent : Theme.t.border;
            }
            LfxText {
                x: 6px;
                width: parent.width - 6px;
                height: 100%;
                text: m.label;
                font-size: 12px;
                font-weight: m.half ? 500 : 600;
                color: m.half ? Theme.t.text-soft : Theme.t.text-muted;
                vertical-alignment: center;
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.t.border;
        }
    }
    // Senderspalte (links, scrollt nur senkrecht mit)
    Rectangle {
        x: 0px;
        y: root.scale-h;
        width: root.chan-w;
        height: parent.height - root.scale-h;
        clip: true;
        background: Theme.t.bg-deep;
        for row[ri] in TvState.epg-rows: Rectangle {
            y: TvState.epg-y + ri * root.row-h;
            height: root.row-h;
            Rectangle {
                x: 0px;
                width: 3px;
                background: row.current ? TvTheme.accent : transparent;
            }
            LfxText {
                x: 8px;
                width: 28px;
                height: 100%;
                text: row.no;
                font-size: Theme.t.fs-meta;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: row.current ? Theme.t.text : Theme.t.text-muted;
            }
            TvBadge {
                x: 44px;
                y: (parent.height - self.height) / 2;
                fill: row.color;
                ink: row.ink;
                text: row.short;
            }
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.t.border;
            }
        }
        TouchArea { }
    }
    Rectangle {
        width: root.chan-w;
        height: root.scale-h;
        background: Theme.t.bg-deep;
    }
}

// Der Seiteninhalt. Der Kasten `box` ist das Loch für das Video.
export component TvPage inherits Rectangle {
    property <bool> epg-tab: TvState.tab == 1;
    property <bool> fs: TvState.fullscreen;
    property <length> pad-x: 36px;
    property <length> top: 12px;
    property <length> area-top: root.top + 40px + 12px;
    property <length> side-w: clamp(320px, root.width * 0.30, 440px);
    property <length> gap: 24px;
    property <length> info-h: 150px;
    property <length> avail-w: root.width - 2 * root.pad-x - root.side-w - root.gap;
    property <length> avail-h: root.height - root.area-top - root.info-h - 12px - 16px;
    property <length> big-w: min(root.avail-w, root.avail-h * 16 / 9);
    property <length> box-w: root.fs ? min(root.width, root.height * 16 / 9) : (root.epg-tab ? 360px : root.big-w);
    property <length> box-h: root.box-w * 9 / 16;
    property <length> box-x: root.fs ? (root.width - root.box-w) / 2 : root.pad-x;
    property <length> box-y: root.fs ? (root.height - root.box-h) / 2 : root.area-top;
    property <color> frame: root.fs ? #000000 : Theme.t.bg;

    background: transparent;

    // Hintergrund rund um das Videoloch
    Rectangle { x: 0px; y: 0px; width: parent.width; height: root.box-y; background: root.frame; }
    Rectangle { x: 0px; y: root.box-y; width: root.box-x; height: root.box-h; background: root.frame; }
    Rectangle { x: root.box-x + root.box-w; y: root.box-y; width: max(parent.width - self.x, 0px); height: root.box-h; background: root.frame; }
    Rectangle { x: 0px; y: root.box-y + root.box-h; width: parent.width; height: max(parent.height - self.y, 0px); background: root.frame; }

    // ---- Tabs ----
    if !root.fs: Rectangle {
        x: root.pad-x;
        y: root.top;
        height: 40px;
        width: 400px;
        TvPill {
            x: 0px;
            y: 2px;
            text: "Jetzt im TV";
            active: TvState.tab == 0;
            clicked => { TvState.select-tab(0); }
        }
        TvPill {
            x: 140px;
            y: 2px;
            text: "Programm";
            active: TvState.tab == 1;
            clicked => { TvState.select-tab(1); }
        }
        TvPill {
            x: 260px;
            y: 2px;
            text: "Zurück";
            has-icon: true;
            icon: Icons.back;
            clicked => { TvState.leave(); }
        }
    }

    // ---- Info unter dem Player (Tab 0) bzw. neben dem Mini-Player (Tab 1) ----
    if !root.fs && TvState.has-entry: Rectangle {
        x: root.epg-tab ? root.pad-x + root.box-w + root.gap : root.pad-x;
        y: root.epg-tab ? root.box-y : root.box-y + root.box-h + 14px;
        width: root.epg-tab ? root.width - self.x - root.pad-x : root.box-w;
        height: root.epg-tab ? root.box-h : root.info-h;
        clip: true;
        ib := TvBadge {
            x: 0px;
            y: 0px;
            fill: TvState.info-color;
            ink: TvState.info-ink;
            text: TvState.info-short;
            height: 22px;
        }
        LfxText {
            x: ib.width + 12px;
            y: 0px;
            height: 22px;
            text: "Sender " + TvState.info-no;
            font-size: 15px;
            font-weight: 700;
            color: Theme.t.text-soft;
            vertical-alignment: center;
        }
        LfxText {
            y: 28px;
            width: 100%;
            height: 38px;
            text: TvState.info-title;
            font-size: 28px;
            font-weight: 700;
            overflow: elide;
        }
        LfxText {
            y: 68px;
            width: 100%;
            height: 22px;
            text: TvState.info-sub;
            font-size: 16px;
            color: Theme.t.text-body;
            overflow: elide;
        }
        LfxText {
            x: 0px;
            y: 94px;
            height: 20px;
            width: 140px;
            text: TvState.info-time;
            font-size: 14px;
            color: Theme.t.text-muted;
        }
        HorizontalLayout {
            x: 146px;
            y: 92px;
            height: 24px;
            spacing: 6px;
            alignment: start;
            for b in TvState.info-badges: Rectangle {
                width: bt.preferred-width + 20px;
                height: 24px;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.t.border;
                bt := LfxText {
                    x: 10px;
                    height: 100%;
                    text: b;
                    font-size: Theme.t.fs-badge;
                    color: Theme.t.text-muted;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            x: 0px;
            y: 124px;
            width: min(parent.width, 420px);
            height: 4px;
            border-radius: 2px;
            background: Theme.t.progress-rail;
            Rectangle {
                x: 0px;
                width: parent.width * clamp(TvState.info-progress, 0.0, 1.0);
                border-radius: 2px;
                background: TvTheme.accent;
            }
        }
        LfxText {
            y: 132px;
            width: 100%;
            height: 18px;
            text: TvState.info-next;
            font-size: 13px;
            color: Theme.t.text-muted;
            overflow: elide;
        }
        if root.epg-tab: TvPill {
            x: 0px;
            y: parent.height - 36px;
            text: "Info";
            has-icon: true;
            icon: Icons.info;
            clicked => { TvState.open-info(); }
        }
    }

    // ---- Senderliste (Tab 0) ----
    if !root.fs && !root.epg-tab: Flickable {
        x: root.width - root.pad-x - root.side-w;
        y: root.area-top;
        width: root.side-w;
        height: root.height - root.area-top - 16px;
        content-width: self.width;
        content-height: TvState.channels.length * 85px;
        content-y <=> TvState.list-y;
        for r[i] in TvState.channels: TvListRow {
            y: i * 85px;
            width: root.side-w;
            d: r;
            current: r.no == TvState.current-channel;
            clicked => { TvState.tune(r.no); }
        }
    }

    // ---- Programm (Tab 1) ----
    if !root.fs && root.epg-tab: Rectangle {
        x: root.pad-x;
        y: root.box-y + root.box-h + 14px;
        width: root.width - 2 * root.pad-x;
        height: root.height - self.y - 16px;
        HorizontalLayout {
            y: 0px;
            height: 36px;
            spacing: 6px;
            alignment: start;
            for day[i] in TvState.days: TvPill {
                text: day;
                active: i == TvState.day-index;
                clicked => { TvState.select-day(i); }
            }
            TvPill {
                text: "Jetzt";
                clicked => { TvState.epg-now(); }
            }
        }
        TvEpg {
            y: 46px;
            width: parent.width;
            height: parent.height - 46px;
        }
    }

    // ---- Player-Kasten ----
    box := Rectangle {
        x: root.box-x;
        y: root.box-y;
        width: root.box-w;
        height: root.box-h;
        background: transparent;
        clip: true;
        init => { TvState.player-rect(root.absolute-position.x + self.x, root.absolute-position.y + self.y, self.width, self.height); }
        changed x => { TvState.player-rect(root.absolute-position.x + self.x, root.absolute-position.y + self.y, self.width, self.height); }
        changed y => { TvState.player-rect(root.absolute-position.x + self.x, root.absolute-position.y + self.y, self.width, self.height); }
        changed width => { TvState.player-rect(root.absolute-position.x + self.x, root.absolute-position.y + self.y, self.width, self.height); }
        changed height => { TvState.player-rect(root.absolute-position.x + self.x, root.absolute-position.y + self.y, self.width, self.height); }

        // schwarzer Grund hinter Zustandskarten und beim Laden
        Rectangle {
            background: TvState.phase == 2 ? transparent : #000000;
        }
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.move) { TvState.activity(); }
            }
            clicked => {
                TvState.activity();
                if (TvState.needs-tap) { TvState.card-button-clicked(); }
            }
        }
        if TvState.phase == 1: Rectangle {
            background: #00000059;
            LfxSpinner {
                size: 40px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - 10px;
            }
            LfxText {
                y: parent.height / 2 + 24px;
                width: 100%;
                height: 20px;
                text: "Sender wird geladen …";
                font-size: Theme.t.fs-meta;
                color: Theme.t.text-muted;
                horizontal-alignment: center;
            }
        }
        if TvState.banner != "": Rectangle {
            x: 12px;
            y: 12px;
            width: bn.preferred-width + 24px;
            height: 28px;
            border-radius: 6px;
            background: #00000099;
            bn := LfxText {
                x: 12px;
                height: 100%;
                text: TvState.banner;
                font-size: Theme.t.fs-meta;
                vertical-alignment: center;
            }
        }
        if TvState.card-kind != 0: Rectangle {
            width: min(parent.width - 32px, 460px);
            height: 52px + (root.box-w < 420px ? 28px : 0px) + (TvState.card-text != "" ? 26px : 0px) + (TvState.card-hint != "" ? 22px : 0px) + (TvState.card-code != "" ? 20px : 0px) + (TvState.card-button != "" ? 52px : 0px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.design == Design.retro ? 0px : 12px;
            background: #141414d1;
            cardcol := VerticalLayout {
                alignment: start;
                x: 18px;
                y: 18px;
                width: parent.width - 36px;
                spacing: 6px;
                LfxText {
                    text: TvState.card-title;
                    wrap: word-wrap;
                    font-size: Theme.t.fs-row-title;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                if TvState.card-text != "": LfxText {
                    text: TvState.card-text;
                    wrap: word-wrap;
                    font-size: Theme.t.fs-meta;
                    color: Theme.t.text-muted;
                    horizontal-alignment: center;
                }
                if TvState.card-hint != "": LfxText {
                    text: TvState.card-hint;
                    wrap: word-wrap;
                    font-size: 13px;
                    color: Theme.t.text-muted;
                    horizontal-alignment: center;
                }
                if TvState.card-code != "": LfxText {
                    text: TvState.card-code;
                    font-size: 11px;
                    color: Theme.t.text-soft;
                    horizontal-alignment: center;
                }
                if TvState.card-button != "": Rectangle {
                    height: 44px;
                    TvPill {
                        x: (parent.width - self.width) / 2;
                        y: 8px;
                        accent: true;
                        text: TvState.card-button;
                        clicked => { TvState.card-button-clicked(); }
                    }
                }
            }
        }
        if TvState.muted-by-policy && TvState.card-kind == 0: TvPill {
            x: parent.width - self.width - 14px;
            y: 14px;
            accent: true;
            text: "Ton an";
            clicked => { TvState.card-button-clicked(); }
        }
        if TvState.digits != "": Rectangle {
            x: parent.width - self.width - 16px;
            y: 16px;
            width: dg.preferred-width + 40px;
            height: 70px;
            border-radius: 10px;
            background: #00000099;
            dg := LfxText {
                x: 20px;
                height: 100%;
                text: TvState.digits;
                font-size: 44px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        // Zapp-Einblendung
        if TvState.zap-on && TvState.card-kind != 5 && root.box-w > 500px: Rectangle {
            x: 16px;
            y: parent.height - self.height - (TvState.controls-on ? 64px : 16px);
            width: min(420px, parent.width - 32px);
            height: 96px;
            border-radius: 10px;
            background: #0f0f0fd1;
            LfxText {
                x: 14px;
                y: 8px;
                width: 40px;
                height: 32px;
                text: TvState.zap-no;
                font-size: 24px;
                font-weight: 800;
                vertical-alignment: center;
            }
            TvBadge {
                x: 58px;
                y: 14px;
                fill: TvState.zap-color;
                ink: TvState.zap-ink;
                text: TvState.zap-short;
            }
            LfxText {
                x: parent.width - 150px;
                y: 8px;
                width: 136px;
                height: 32px;
                text: TvState.zap-time;
                font-size: Theme.t.fs-meta;
                color: Theme.t.text-muted;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            LfxText {
                x: 14px;
                y: 44px;
                width: parent.width - 28px;
                height: 22px;
                text: TvState.zap-title;
                font-size: Theme.t.fs-meta;
                font-weight: 600;
                overflow: elide;
            }
            Rectangle {
                x: 14px;
                y: parent.height - 18px;
                width: parent.width - 28px;
                height: 3px;
                background: #ffffff33;
                Rectangle {
                    x: 0px;
                    width: parent.width * clamp(TvState.zap-progress, 0.0, 1.0);
                    background: TvTheme.accent;
                }
            }
        }
        // Bedienleiste
        if TvState.controls-on: Rectangle {
            y: parent.height - self.height;
            height: 56px;
            background: @linear-gradient(0deg, #000000c7 0%, #00000000 100%);
            TvIconBtn {
                x: 8px;
                y: 8px;
                icon: TvState.muted ? Icons.mute : Icons.volume;
                clicked => { TvState.toggle-mute(); }
            }
            if root.box-w > 500px: LfxSlider {
                x: 52px;
                y: 18px;
                width: 96px;
                value: TvState.muted ? 0.0 : TvState.volume;
                seeked(v) => { TvState.set-volume(v); }
            }
            if root.box-w > 500px: TvIconBtn {
                x: (parent.width - 88px) / 2;
                y: 8px;
                icon: Icons.chevron-down;
                clicked => { TvState.zap(-1); }
            }
            if root.box-w > 500px: TvIconBtn {
                x: (parent.width - 88px) / 2 + 48px;
                y: 8px;
                icon: Icons.chevron-up;
                clicked => { TvState.zap(1); }
            }
            TvIconBtn {
                x: parent.width - 96px;
                y: 8px;
                icon: Icons.info;
                clicked => { TvState.open-info(); }
            }
            TvIconBtn {
                x: parent.width - 48px;
                y: 8px;
                icon: Icons.fullscreen;
                pressed-state: TvState.fullscreen;
                clicked => { TvState.toggle-fullscreen(); }
            }
        }
    }

    // ---- Laden / Fehler (deckt alles ab) ----
    if TvState.loading || TvState.load-error != "": Rectangle {
        background: Theme.t.bg;
        TouchArea { }
        if TvState.load-error == "": LfxSpinner {
            size: 48px;
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.36;
        }
        LfxText {
            y: parent.height * 0.36 + 70px;
            width: 100%;
            height: 30px;
            text: TvState.load-error == "" ? TvState.load-text : TvState.load-error;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        if TvState.load-error != "": Rectangle {
            y: parent.height * 0.36 + 120px;
            height: 44px;
            TvPill {
                x: (parent.width - self.width) / 2;
                text: "Zurück";
                has-icon: true;
                icon: Icons.back;
                clicked => { TvState.leave(); }
            }
        }
    }

    // ---- Info-Karte ----
    if TvState.ic-open: Rectangle {
        background: #000000b3;
        TouchArea { clicked => { TvState.close-info(); } }
        Rectangle {
            width: min(560px, parent.width - 48px);
            height: min(icol.preferred-height + 32px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.design == Design.retro ? 0px : 14px;
            background: Theme.t.surface;
            clip: true;
            TouchArea { }
            icol := VerticalLayout {
                padding: 0px;
                spacing: 8px;
                Rectangle {
                    height: (parent.width) * 9 / 16 * 0.55;
                    background: @linear-gradient(135deg, TvState.ic-color 0%, TvState.ic-color.darker(0.6) 100%);
                    Text {
                        text: TvState.ic-short;
                        color: TvState.ic-ink;
                        font-family: Theme.t.font-family;
                        font-size: 40px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-bottom: 18px;
                    spacing: 6px;
                    LfxText {
                        text: TvState.ic-channel;
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.t.text-soft;
                    }
                    LfxText {
                        text: TvState.ic-title;
                        font-size: 24px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    if TvState.ic-sub != "": LfxText {
                        text: TvState.ic-sub;
                        font-size: 15px;
                        color: Theme.t.text-body;
                    }
                    LfxText {
                        text: TvState.ic-time;
                        font-size: 14px;
                        color: Theme.t.text-muted;
                    }
                    if TvState.ic-meta != "": LfxText {
                        text: TvState.ic-meta;
                        font-size: 14px;
                        color: Theme.t.text-muted;
                    }
                    if TvState.ic-overview != "": LfxText {
                        text: TvState.ic-overview;
                        font-size: 14px;
                        color: Theme.t.text-body;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        height: 44px;
                        for a[i] in TvState.ic-actions: TvPill {
                            y: 4px;
                            accent: i == 0;
                            text: a;
                            clicked => { TvState.info-action(i); }
                        }
                    }
                }
            }
            Rectangle {
                x: parent.width - 52px;
                y: 8px;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: #00000099;
                LfxIcon {
                    source: Icons.close;
                    size: 22px;
                    x: 11px;
                    y: 11px;
                    tint: #ffffff;
                }
                TouchArea { clicked => { TvState.close-info(); } }
            }
        }
    }

    // ---- Hinweis ----
    if TvState.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 70px;
        width: min(tt.preferred-width + 40px, parent.width - 32px);
        height: 44px;
        border-radius: 10px;
        background: Theme.t.surface-3;
        tt := LfxText {
            x: 20px;
            width: parent.width - 40px;
            height: 100%;
            text: TvState.toast;
            font-size: 15px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
