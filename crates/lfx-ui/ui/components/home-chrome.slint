import { Theme, Design } from "../theme/theme.slint";
import { PrimeHeader } from "prime-header.slint"; // W3-prime
import { PrimeProfileMenu } from "prime-menus.slint"; // W3-prime
import { HomeUi } from "../pages/home-types.slint";
import { HomeHeader } from "home-header.slint";
import { RetroHeader } from "retro-header.slint"; // W3-retro
import { ProfileMenu, DsPanel, SecretPanel } from "home-menus.slint";
import { PlusHeader, PlusSwitcher, PlusProfileMenu } from "plus-header.slint"; // W3-plus

// Kopfleiste samt Menüs (Profil, Datensparmodus, Geheimmenü): gemeinsam für Startseite und Bibliotheksseiten.
// Alle Ereignisse laufen über `event`/`event-f` zu den Startseiten-Handlern in Rust (`on_home_event`).
export component HomeChrome inherits Rectangle {
    in property <HomeUi> ui;
    in property <string> version;
    in property <length> gutter;
    in property <length> header-h;
    in property <bool> scrolled;
    in property <int> focus-index: -1;
    in property <int> current: 0;
    // W3-plus: Umschalter-Pille („Für dich“ | Filme | Serien) unter der LENZ+-Kopfleiste
    in property <bool> switcher: false;
    callback event(string, int);
    callback event-f(string, float);

    // Klick daneben schließt Profilmenü und Datensparmodus-Panel
    if root.ui.menu == 1 || root.ui.menu == 2: TouchArea {
        clicked => { root.event("menu-close", 0); }
    }

    if Theme.design == Design.retro: RetroHeader { // W3-retro
        x: 0px;
        y: 0px;
        width: root.width;
        gutter: root.gutter;
        scrolled: root.scrolled;
        focus-index: root.focus-index;
        current: root.current;
        ds-on: root.ui.ds-on;
        initial: root.ui.user-initial;
        narrow: root.width < 900px;
        pick(i) => { root.event("nav", i); }
        logo-clicked => { root.event("logo", 0); }
    }
    if Theme.design != Design.plus && Theme.design != Design.prime && Theme.design != Design.retro: HomeHeader { // W3-plus W3-prime W3-retro
        x: 0px;
        y: 0px;
        width: root.width;
        gutter: root.gutter;
        scrolled: root.scrolled;
        focus-index: root.focus-index;
        current: root.current;
        ds-on: root.ui.ds-on;
        initial: root.ui.user-initial;
        narrow: root.width < 900px;
        pick(i) => { root.event("nav", i); }
        logo-clicked => { root.event("logo", 0); }
    }

    if Theme.design == Design.plus: PlusHeader { // W3-plus
        x: 0px;
        y: 0px;
        width: root.width;
        scrolled: root.scrolled;
        focus-index: root.focus-index;
        current: root.current;
        ds-on: root.ui.ds-on;
        initial: root.ui.user-initial;
        user-name: root.ui.user-name;
        pick(i) => { root.event("nav", i); }
        logo-clicked => { root.event("logo", 0); }
    }
    if Theme.design == Design.plus && root.switcher: PlusSwitcher { // W3-plus
        x: (root.width - self.width) / 2;
        y: 84px;
        opacity: root.scrolled ? 0.0 : 1.0;
        visible: !root.scrolled;
        animate opacity { duration: 300ms; easing: Theme.t.ease; }
        tabs: ["Für dich", "Filme", "Serien"];
        current: 0;
        pick(i) => { root.event("plus-tab", i); }
    }
    if Theme.design == Design.prime: PrimeHeader { // W3-prime
        x: 0px;
        y: 0px;
        width: root.width;
        gutter: root.gutter;
        scrolled: root.scrolled;
        focus-index: root.focus-index;
        current: root.current;
        ds-on: root.ui.ds-on;
        initial: root.ui.user-initial;
        narrow: root.width < 800px;
        pick(i) => { root.event("nav", i); }
        logo-clicked => { root.event("logo", 0); }
    }
    if root.ui.menu == 1 && Theme.design == Design.plus: PlusProfileMenu { // W3-plus
        x: 17px + 4px + 96px + 8px;
        y: root.header-h - 6px;
        index: root.ui.menu-index;
        pick(i) => { root.event("profile-item", i); }
    }
    if root.ui.menu == 1 && Theme.design == Design.prime: PrimeProfileMenu { // W3-prime
        sheet: root.width < 800px;
        sheet-w: root.width;
        initial: root.ui.user-initial;
        x: root.width < 800px ? 0px : root.width - root.gutter - self.width + 8px;
        y: root.width < 800px ? root.height - self.height : root.header-h - 8px;
        user-name: root.ui.user-name;
        index: root.ui.menu-index;
        pick(i) => { root.event("profile-item", i); }
    }
    if root.ui.menu == 1 && Theme.design != Design.plus && Theme.design != Design.prime: ProfileMenu { // W3-plus W3-prime
        x: root.width - root.gutter - self.width + 8px;
        y: root.header-h - 18px;
        user-name: root.ui.user-name;
        index: root.ui.menu-index;
        pick(i) => { root.event("profile-item", i); }
    }
    if root.ui.menu == 2: DsPanel {
        x: Theme.design == Design.plus ? root.width - self.width - 130px : root.width - root.gutter - self.width - 52px; // W3-plus
        y: root.header-h - 18px;
        on: root.ui.ds-on;
        parts: root.ui.ds-parts;
        labels: root.ui.ds-labels;
        index: root.ui.menu-index;
        main-toggled => { root.event("ds-main", 0); }
        part-toggled(i) => { root.event("ds-part", i); }
        reset => { root.event("ds-reset", 0); }
    }
    if root.ui.menu == 3: SecretPanel {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        ui: root.ui;
        version: root.version;
        close => { root.event("menu-close", 0); }
        scale(k, v) => { root.event-f(k, v); }
        ds-part(i) => { root.event("ds-part", i); }
        ds-reset => { root.event("ds-reset", 0); }
        clear-cache => { root.event("clear-cache", 0); }
    }
}
