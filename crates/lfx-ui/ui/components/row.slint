import { Theme, Design } from "../theme/theme.slint";
import { CardAspect, CardData } from "types.slint";
import { LfxText } from "text.slint";
import { LfxCard } from "card.slint";
import { LfxIcon } from "icon.slint";
import { Icons } from "../icons.slint";

// Zeile: Titel plus horizontal virtualisierte Kartenliste (nur sichtbare Karten und ein Puffer sind instanziiert).
// Kartenbreite wie im Web (rows.css): (Breite - Rand - n * Abstand - Anschnitt) / n mit n = cards-visible-at(Breite),
// Rand = gutter-at(Breite). Fokus-Index setzt lfx-nav (`focused-index`, -1 = keiner); `reveal(i)` scrollt dorthin.
export component LfxRow inherits Rectangle {
    in property <string> title;
    in property <[CardData]> items;
    in property <CardAspect> aspect: CardAspect.wide;
    in property <int> focused-index: -1;
    // Pfeil-Knöpfe (am Desktop mit Maus sichtbar)
    in property <bool> show-arrows: true;
    // Hover-Zoom für alle Karten erzwingen (Tests)
    in property <bool> force-hot: false;
    in-out property <length> scroll-x: 0px;
    callback card-clicked(int);

    property <length> gutter: Theme.gutter-at(root.width);
    property <int> n: Theme.cards-visible-at(root.width);
    property <length> gap: Theme.t.card-gap;
    property <length> card-h: ((root.width - root.gutter - root.n * root.gap - Theme.t.card-peek) / root.n) * 9 / 16;
    property <length> wide-w: (root.width - root.gutter - root.n * root.gap - Theme.t.card-peek) / root.n;
    property <length> card-w: root.aspect == CardAspect.poster ? root.card-h * 2 / 3 : root.wide-w;
    // Poster sind so hoch wie die 16:9-Karten derselben Zeile
    property <length> pitch: root.card-w + root.gap;
    property <length> max-scroll: max(0px, root.items.length * root.pitch - (root.width - 2 * root.gutter + root.gap));
    property <int> first: max(0, floor(root.scroll-x / root.pitch) - 1);
    property <int> pool: root.n + 4;
    property <length> title-h: 24px;
    property <length> pad-y: 14px;

    preferred-height: root.title-h + Theme.t.row-title-gap + root.card-h + 2 * root.pad-y;
    changed focused-index => {
        if (root.focused-index >= 0) { root.reveal(root.focused-index); }
    }
    animate scroll-x { duration: Theme.t.dur * 2; easing: Theme.t.ease-out; }

    // Seitenweise blättern (dir = -1 / +1) und einen Index sichtbar machen.
    public function page(dir: int) {
        root.scroll-x = min(root.max-scroll, max(0px, root.scroll-x + dir * (root.n - 1) * root.pitch));
    }
    public function reveal(idx: int) {
        if (idx * root.pitch < root.scroll-x) {
            root.scroll-x = max(0px, idx * root.pitch);
        } else if ((idx + 1) * root.pitch - root.gap > root.scroll-x + root.width - 2 * root.gutter) {
            root.scroll-x = min(root.max-scroll, (idx + 1) * root.pitch - (root.width - 2 * root.gutter));
        }
    }

    LfxText {
        x: root.gutter;
        y: 0px;
        height: root.title-h;
        text: Theme.design == Design.retro ? "// " + root.title : root.title;
        font-family: Theme.design == Design.retro ? Theme.t.retro-font-pixel : Theme.t.font-family;
        font-size: Theme.design == Design.retro ? 22px : Theme.t.fs-row-title;
        font-weight: Theme.t.fw-row-title;
        color: Theme.design == Design.retro ? Theme.t.retro-amber : #ffffff;
        vertical-alignment: center;
    }

    viewport := Rectangle {
        y: root.title-h + Theme.t.row-title-gap;
        height: root.card-h + 2 * root.pad-y;
        clip: true;

        // Mausrad: horizontal (oder vertikal als Ersatz) scrollen; Karten reichen das Ereignis durch.
        TouchArea {
            scroll-event(e) => {
                // Nur waagerechte Bewegung (Touchpad, Shift+Rad) scrollt die Zeile; das normale Rad bleibt der Seite.
                if (e.delta-x != 0px) {
                    root.scroll-x = min(root.max-scroll, max(0px, root.scroll-x - e.delta-x));
                    return accept;
                }
                reject
            }
        }

        for slot in root.pool: Rectangle {
            property <int> idx: root.first + slot;
            x: root.gutter + idx * root.pitch - root.scroll-x;
            y: root.pad-y;
            width: root.card-w;
            height: root.card-h;
            if idx < root.items.length: LfxCard {
                width: 100%;
                height: 100%;
                data: root.items[idx];
                aspect: root.aspect;
                focused: idx == root.focused-index;
                force-hot: root.force-hot && idx == 1;
                clicked => { root.card-clicked(idx); }
            }
        }

        if root.show-arrows && root.scroll-x > 0px: Rectangle {
            x: 0px;
            width: root.gutter;
            y: root.pad-y;
            height: root.card-h;
            background: #00000066;
            LfxIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: Icons.chevron-left;
                size: 28px;
                tint: #ffffff;
            }
            TouchArea { clicked => { root.page(-1); } }
        }
        if root.show-arrows && root.scroll-x < root.max-scroll: Rectangle {
            x: root.width - root.gutter;
            width: root.gutter;
            y: root.pad-y;
            height: root.card-h;
            background: #00000066;
            LfxIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: Icons.chevron-right;
                size: 28px;
                tint: #ffffff;
            }
            TouchArea { clicked => { root.page(1); } }
        }
    }
}
