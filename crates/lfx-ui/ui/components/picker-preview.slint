import { LfxText } from "text.slint";

// Mini-Vorschau je Design, rein aus Rechtecken gezeichnet (Port der CSS-Vorschau des Web-Pickers).
// id: 0 LENZFLIX, 1 LENZ+, 2 LENZPRIME, 3 LENZ//84, 4 VIDEOTHEK LENZ.
export component PickerPreview inherits Rectangle {
    in property <int> id: 0;
    in property <[color]> covers;
    height: self.width * 0.58;
    clip: true;
    border-radius: 8px;
    background: root.id == 1 ? @linear-gradient(180deg, #0f1a3c 0%, #0a1230 100%)
        : (root.id == 2 ? @linear-gradient(180deg, #0f1626 0%, #0a0e17 100%)
        : (root.id == 3 ? #0a0603
        : (root.id == 4 ? #0d1330 : #0a0a0a)));

    // LENZFLIX: roter Logo-Balken, runder Hero, Querformat-Kacheln
    if root.id == 0: Rectangle {
        Rectangle { x: parent.width * 0.06; y: parent.height * 0.06; width: parent.width * 0.22; height: parent.height * 0.06; border-radius: 2px; background: #e50914; }
        Rectangle {
            x: parent.width * 0.06; y: parent.height * 0.18; width: parent.width * 0.88; height: parent.height * 0.40;
            border-radius: 10px;
            background: @linear-gradient(120deg, #5a1015 0%, #2a2a2a 55%, #3a3a3a 100%);
        }
        HorizontalLayout {
            x: parent.width * 0.06; y: parent.height * 0.65; width: parent.width * 0.88; height: parent.height * 0.24;
            spacing: parent.width * 0.03;
            for k in 4: Rectangle { border-radius: 3px; background: @linear-gradient(160deg, #3b3b3b 0%, #1e1e1e 100%); }
        }
    }
    // LENZ+: schwarze Kopfleiste, Hero-Karussell, Poster
    if root.id == 1: Rectangle {
        Rectangle {
            height: parent.height * 0.11;
            background: #000000;
            HorizontalLayout {
                alignment: center;
                spacing: parent.width * 0.04;
                padding-top: parent.height * 0.36;
                padding-bottom: parent.height * 0.36;
                for k in 4: Rectangle { width: parent.width * 0.04; border-radius: 3px; background: #ffffff80; }
            }
        }
        Rectangle { x: parent.width * 0.01; y: parent.height * 0.20; width: parent.width * 0.11; height: parent.height * 0.34; border-radius: 6px; opacity: 0.6; background: @linear-gradient(130deg, #1d3270 0%, #2c2a68 100%); }
        Rectangle { x: parent.width * 0.88; y: parent.height * 0.20; width: parent.width * 0.11; height: parent.height * 0.34; border-radius: 6px; opacity: 0.6; background: @linear-gradient(130deg, #1d3270 0%, #2c2a68 100%); }
        Rectangle {
            x: parent.width * 0.14; y: parent.height * 0.17; width: parent.width * 0.72; height: parent.height * 0.40;
            border-radius: 6px;
            border-width: 1px;
            border-color: #ffffff40;
            background: @linear-gradient(130deg, #2c4fa8 0%, #5a3fa0 100%);
        }
        HorizontalLayout {
            y: parent.height * 0.61;
            height: parent.height * 0.05;
            alignment: center;
            spacing: parent.width * 0.02;
            for k in 3: Rectangle { width: parent.height * 0.05; border-radius: 3px; background: k == 0 ? #ffffff : #ffffff59; }
        }
        HorizontalLayout {
            x: parent.width * 0.06; y: parent.height * 0.70; width: parent.width * 0.88; height: parent.height * 0.26;
            spacing: parent.width * 0.025;
            for k in 5: Rectangle { border-radius: 4px; background: @linear-gradient(160deg, #3a4a86 0%, #1c2447 100%); }
        }
    }
    // LENZPRIME: Vollbild-Hero mit Textzeilen und Knopf, Kacheln mit Badge
    if root.id == 2: Rectangle {
        Rectangle { height: parent.height * 0.60; background: @linear-gradient(100deg, #1a3a66 0%, #0a0e17 70%); }
        Rectangle { x: parent.width * 0.06; y: parent.height * 0.14; width: parent.width * 0.34; height: parent.height * 0.06; border-radius: 3px; background: #ffffffd9; }
        Rectangle { x: parent.width * 0.06; y: parent.height * 0.25; width: parent.width * 0.22; height: parent.height * 0.04; border-radius: 3px; background: #ffffff73; }
        Rectangle { x: parent.width * 0.06; y: parent.height * 0.38; width: parent.width * 0.20; height: parent.height * 0.10; border-radius: 999px; background: #1a98ff; }
        HorizontalLayout {
            x: parent.width * 0.06; y: parent.height * 0.66; width: parent.width * 0.88; height: parent.height * 0.28;
            spacing: parent.width * 0.03;
            for k in 4: Rectangle {
                border-radius: 5px;
                background: @linear-gradient(160deg, #2a3550 0%, #131a2a 100%);
                Rectangle { x: 4px; y: 4px; width: parent.width * 0.3; height: 5px; border-radius: 2px; background: #1a98ff; }
            }
        }
    }
    // LENZ//84: Bernstein-Sonne über Neon-Gitter und Abtastzeilen
    if root.id == 3: Rectangle {
        Rectangle {
            x: (parent.width - self.width) / 2; y: parent.height * 0.14; width: parent.height * 0.46; height: parent.height * 0.46;
            border-radius: self.width / 2;
            background: @linear-gradient(180deg, #ffb000 0%, #ff5a1f 100%);
        }
        Rectangle { y: parent.height * 0.60; height: parent.height * 0.40; background: #1a0d03; }
        for k in 5: Rectangle { y: parent.height * (0.62 + k * k * 0.0165 + 0.02); height: 1px; background: #ffb000b3; }
        for k in 9: Rectangle { x: parent.width * (k / 8.0); y: parent.height * 0.60; width: 1px; height: parent.height * 0.40; background: #ff5a1f66; }
        for k in 14: Rectangle { y: parent.height * (k / 14.0); height: 1px; background: #00000040; }
    }
    // VIDEOTHEK LENZ: Schild, zwei Regalreihen mit Platzhalter-Covern (Tagesmischung), Teppich
    if root.id == 4: Rectangle {
        Rectangle {
            x: parent.width * 0.2; y: parent.height * 0.05; width: parent.width * 0.6; height: parent.height * 0.14;
            border-radius: 3px;
            background: #ffd23f;
            LfxText { text: "VIDEOTHEK LENZ"; color: #0d1330; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        }
        HorizontalLayout {
            x: parent.width * 0.08; y: parent.height * 0.25; width: parent.width * 0.84; height: parent.height * 0.26;
            spacing: parent.width * 0.012;
            for k in 7: Rectangle { border-radius: 2px; background: root.covers.length > k ? root.covers[k] : #3a3a5a; }
        }
        HorizontalLayout {
            x: parent.width * 0.08; y: parent.height * 0.55; width: parent.width * 0.84; height: parent.height * 0.26;
            spacing: parent.width * 0.012;
            for k in 6: Rectangle { border-radius: 2px; background: root.covers.length > k + 7 ? root.covers[k + 7] : #3a3a5a; }
        }
        Rectangle { y: parent.height * 0.88; height: parent.height * 0.12; background: #2446a8; }
    }
}
