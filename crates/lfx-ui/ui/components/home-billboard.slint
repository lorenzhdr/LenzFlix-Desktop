import { Theme } from "../theme/theme.slint";
import { ButtonKind } from "types.slint";
import { LfxText } from "text.slint";
import { LfxIcon } from "icon.slint";
import { LfxButton } from "button.slint";
import { Icons } from "../icons.slint";
import { HeroData } from "../pages/types.slint";
import { HomeUi } from "../pages/home-types.slint";

// Billboard (Web: `#lfx-billboard`, `billboard.css`): eingerückte Karte mit Radius 18, Bild, Schattierung,
// Mini-Marke, Ton-Knopf, Text unten links, Knöpfe, Marke unten rechts, Positionspunkte (bei Hover).
// Läuft der Trailer (`ui.trailer-on`), wird das Bild ausgeblendet und die Fläche durchsichtig: die Video-Ebene der
// Shell scheint durch (die Seite hält dort ein Loch im Hintergrund). Die Ecken füllt dann `corner` nach.
export component HomeBillboard inherits Rectangle {
    in property <HeroData> hero;
    in property <HomeUi> ui;
    in property <string> badge;
    in property <string> primary-text: "Abspielen";
    in property <int> focus-index: -1;
    // Beschreibung (Web: standardmäßig aus, `--lfx-bb-desc-display: none`)
    in property <bool> show-desc: false;
    callback play();
    callback info();
    callback mute();
    callback dot(int);

    property <length> radius: Theme.t.billboard-radius;
    property <length> btn-bottom: 27px;
    property <bool> hole: root.ui.trailer-on;

    background: transparent;
    border-radius: root.radius;
    clip: true;

    ta-bb := TouchArea { }
    // Hintergrund und Bild
    Rectangle {
        background: root.hole ? transparent : #0c0c0c;
    }
    if root.hero.has-backdrop: Image {
        width: 100%;
        height: 100%;
        source: root.hero.backdrop;
        image-fit: cover;
        opacity: root.hole ? 0.0 : 1.0;
        animate opacity { duration: 800ms; easing: Theme.t.ease; }
    }
    Rectangle {
        opacity: root.hole ? 0.0 : 1.0;
        animate opacity { duration: 800ms; easing: Theme.t.ease; }
        background: @linear-gradient(90deg, #00000099 0%, #00000000 55%);
    }
    Rectangle {
        background: @linear-gradient(0deg, #00000073 0%, #00000000 25%);
    }

    Image {
        x: 34px;
        y: 20px;
        width: 10px;
        height: 24px;
        source: @image-url("../../../../assets/logo/lenzflix-l.svg");
        image-fit: contain;
    }

    // Ton-Knopf
    if root.ui.trailer-btn: Rectangle {
        x: parent.width - 28px - 30px;
        y: 20px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: #3f3b38d9;
        LfxIcon {
            x: 7px;
            y: 7px;
            source: root.ui.trailer-muted ? Icons.mute : Icons.volume;
            size: 16px;
        }
        TouchArea { clicked => { root.mute(); } }
    }

    // Text unten links
    VerticalLayout {
        x: 28px;
        y: parent.height - self.height - (root.btn-bottom + Theme.t.btn-h + 34px);
        width: max(220px, min(360px, parent.width * 0.30));
        spacing: 20px;
        alignment: end;
        if root.hero.has-logo: Image {
            source: root.hero.logo;
            height: min(110px, parent.height * 0.3);
            image-fit: contain;
            horizontal-alignment: left;
            vertical-alignment: bottom;
        }
        if !root.hero.has-logo && root.hero.has-item: LfxText {
            text: root.hero.title;
            font-size: 34px;
            font-weight: 700;
            wrap: word-wrap;
            overflow: elide;
        }
        if root.hero.meta != "": LfxText {
            text: root.hero.meta;
            font-size: Theme.t.fs-meta;
            font-weight: 600;
        }
        if root.show-desc && root.hero.overview != "": LfxText {
            text: root.hero.overview;
            font-size: Theme.t.fs-body;
            wrap: word-wrap;
            overflow: elide;
            max-height: 44px;
        }
    }

    // Knöpfe
    if root.hero.has-item: HorizontalLayout {
        x: 28px;
        y: parent.height - Theme.t.btn-h - root.btn-bottom;
        height: Theme.t.btn-h;
        spacing: Theme.t.btn-gap;
        LfxButton {
            width: 178px;
            kind: ButtonKind.primary;
            text: root.primary-text;
            icon: Icons.play;
            has-icon: true;
            focused: root.focus-index == 0;
            clicked => { root.play(); }
        }
        LfxButton {
            width: 184px;
            kind: ButtonKind.secondary;
            text: "Weitere Infos";
            focused: root.focus-index == 1;
            clicked => { root.info(); }
        }
    }
    // Marke unten rechts
    if root.badge != "": Rectangle {
        x: parent.width - self.width - 28px;
        y: parent.height - self.height - root.btn-bottom;
        width: badge-text.preferred-width + 24px + 24px;
        height: 36px;
        border-radius: 8px;
        background: #141414d9;
        LfxIcon {
            x: 12px;
            y: 10px;
            source: Icons.check;
            size: 16px;
        }
        badge-text := LfxText {
            x: 36px;
            height: 100%;
            text: root.badge;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    // Positionspunkte (nur bei Hover)
    if root.ui.hero-count > 1: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 24px;
        width: root.ui.hero-count * 16px + (root.ui.hero-count - 1) * 4px;
        height: 14px;
        opacity: dots-area.has-hover || ta-bb.has-hover ? 1.0 : 0.0;
        animate opacity { duration: Theme.t.dur; easing: Theme.t.ease; }
        for d in root.ui.hero-count: Rectangle {
            x: d * 20px;
            width: 16px;
            height: 14px;
            Rectangle {
                y: 5px;
                height: 3px;
                border-radius: 2px;
                background: d == root.ui.hero-index ? #ffffff : #ffffff59;
            }
            TouchArea { clicked => { root.dot(d); } }
        }
    }
    dots-area := TouchArea {
        x: (parent.width - 200px) / 2;
        y: parent.height - 40px;
        width: 200px;
        height: 40px;
    }
}
